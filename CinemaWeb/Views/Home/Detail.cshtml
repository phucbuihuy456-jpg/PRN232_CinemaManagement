@model CinemaWeb.Models.MovieItemViewModel
@{
    ViewData["Title"] = Model.Title + " - Chi Tiết Phim";

    // Chuẩn hóa trailer url nếu là Youtube watch link
    string? embedTrailerUrl = null;
    if (!string.IsNullOrEmpty(Model.TrailerUrl))
    {
        if (Model.TrailerUrl.Contains("youtube.com/watch?v="))
        {
            embedTrailerUrl = Model.TrailerUrl.Replace("watch?v=", "embed/").Split('&')[0];
        }
        else if (Model.TrailerUrl.Contains("youtu.be/"))
        {
            embedTrailerUrl = Model.TrailerUrl.Replace("youtu.be/", "youtube.com/embed/");
        }
        else
        {
            embedTrailerUrl = Model.TrailerUrl;
        }
    }

    var badgeClass = Model.AgeRating switch
    {
        "P" => "badge-age-p",
        "C13" => "badge-age-c13",
        "C16" => "badge-age-c16",
        "C18" => "badge-age-c18",
        _ => "bg-secondary text-white"
    };

    var posterUrl = !string.IsNullOrEmpty(Model.PosterUrl) 
        ? Model.PosterUrl 
        : "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=800";
}

<!-- BACKDROP HEADER -->
<div class="movie-detail-backdrop position-relative py-5" style="background: linear-gradient(180deg, rgba(20,20,20,0.85) 0%, rgba(20,20,20,1) 100%), url('@posterUrl') center/cover no-repeat;">
    <div class="container py-4">
        <!-- Nút quay lại -->
        <div class="mb-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
            </a>
        </div>

        <div class="row g-4 align-items-start">
            <!-- Cột Poster -->
            <div class="col-12 col-md-4 col-lg-3 text-center text-md-start">
                <div class="detail-poster-wrapper rounded-4 overflow-hidden shadow-lg border border-secondary border-opacity-25 position-relative">
                    @if (!string.IsNullOrEmpty(Model.AgeRating))
                    {
                        <span class="movie-age-badge @badgeClass">@Model.AgeRating</span>
                    }
                    <img src="@posterUrl" alt="@Model.Title" class="img-fluid w-100 detail-poster-img" />
                </div>
            </div>

            <!-- Cột Thông tin chính -->
            <div class="col-12 col-md-8 col-lg-9">
                <!-- Badges trạng thái & thời lượng -->
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    @if (Model.IsNowShowing)
                    {
                        <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-play-circle-fill me-1"></i> Đang Chiếu</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="bi bi-calendar2-week-fill me-1"></i> Sắp Chiếu</span>
                    }
                    <span class="badge bg-dark border border-secondary px-3 py-2 fs-6 text-white-50">
                        <i class="bi bi-clock me-1 text-danger"></i> @Model.DurationMinutes phút
                    </span>
                    <span class="badge bg-dark border border-secondary px-3 py-2 fs-6 text-white-50">
                        <i class="bi bi-translate me-1 text-info"></i> @(string.IsNullOrEmpty(Model.Language) ? "Tiếng Việt" : Model.Language)
                    </span>
                </div>

                <!-- Tên phim -->
                <h1 class="display-5 fw-bold text-white mb-3 text-uppercase">@Model.Title</h1>

                <!-- Thông số chi tiết -->
                <div class="bg-dark bg-opacity-50 p-4 rounded-4 border border-secondary border-opacity-25 mb-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-white-50 d-block small mb-1"><i class="bi bi-tags-fill me-1 text-danger"></i> Thể Loại</span>
                            <span class="fw-semibold text-light">@Model.GenreDisplay</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-white-50 d-block small mb-1"><i class="bi bi-person-video me-1 text-warning"></i> Đạo Diễn</span>
                            <span class="fw-semibold text-light">@(string.IsNullOrEmpty(Model.Director) ? "Đang cập nhật" : Model.Director)</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-white-50 d-block small mb-1"><i class="bi bi-people-fill me-1 text-primary"></i> Diễn Viên</span>
                            <span class="fw-semibold text-light">@(string.IsNullOrEmpty(Model.Cast) ? "Đang cập nhật" : Model.Cast)</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-white-50 d-block small mb-1"><i class="bi bi-calendar-event me-1 text-success"></i> Khởi Chiếu</span>
                            <span class="fw-semibold text-light">@Model.ReleaseDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>

                <!-- Nút hành động đặt vé -->
                <div class="d-flex flex-wrap gap-3">
                    @if (!string.IsNullOrEmpty(embedTrailerUrl))
                    {
                        <a href="#trailerSection" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold rounded-3">
                            <i class="bi bi-play-circle me-2"></i> Xem Trailer
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NỘI DUNG TÓM TẮT & TRAILER -->
<div class="container py-5">
    <!-- KHỐI CHỌN SUẤT CHIẾU THEO THỜI GIAN CỦA KHÁCH HÀNG (CÁCH B) -->
    <div id="showtimes-section" class="mb-5 p-4 rounded-4 bg-dark border border-secondary border-opacity-25 shadow-lg">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-50">
            <div>
                <h3 class="text-white fw-bold mb-1">
                    <i class="bi bi-calendar2-range-fill text-danger me-2"></i> Lịch Chiếu & Đặt Vé
                </h3>
                <p class="text-secondary small mb-0">Vui lòng chọn khung giờ chiếu phù hợp để tiến hành chọn ghế ngồi trong rạp</p>
            </div>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill font-monospace">
                <i class="bi bi-film me-1"></i> @Model.Title
            </span>
        </div>

        @if (Model.Showtimes != null && Model.Showtimes.Any())
        {
            var showtimesByDate = Model.Showtimes
                .OrderBy(s => s.StartTime)
                .GroupBy(s => s.StartTime.Date)
                .ToList();

            <!-- TAB NGÀY CHIẾU -->
            <ul class="nav nav-pills gap-2 mb-4" id="showtimeDateTabs" role="tablist">
                @for (int i = 0; i < showtimesByDate.Count; i++)
                {
                    var group = showtimesByDate[i];
                    var date = group.Key;
                    var dateTitle = date == DateTime.Today ? "Hôm nay" : 
                                    date == DateTime.Today.AddDays(1) ? "Ngày mai" : 
                                    date.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"));
                    var tabId = $"date-tab-{date:yyyyMMdd}";
                    var paneId = $"pane-{date:yyyyMMdd}";

                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(i == 0 ? "active" : "") rounded-3 px-3 py-2 text-start" 
                                id="@tabId" 
                                data-bs-toggle="pill" 
                                data-bs-target="#@paneId" 
                                type="button" 
                                role="tab">
                            <span class="d-block small text-uppercase text-secondary fw-semibold">@dateTitle</span>
                            <strong class="fs-6">@date.ToString("dd/MM/yyyy")</strong>
                        </button>
                    </li>
                }
            </ul>

            <!-- DANH SÁCH SUẤT CHIẾU THEO NGÀY -->
            <div class="tab-content" id="showtimeTabContent">
                @for (int i = 0; i < showtimesByDate.Count; i++)
                {
                    var group = showtimesByDate[i];
                    var date = group.Key;
                    var paneId = $"pane-{date:yyyyMMdd}";

                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="@paneId" role="tabpanel">
                        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
                            @foreach (var st in group.OrderBy(s => s.StartTime))
                            {
                                <div class="col">
                                    <a asp-controller="Booking" asp-action="SeatMap" asp-route-id="@st.Id" 
                                       class="card bg-black border border-secondary border-opacity-50 text-decoration-none h-100 p-3 text-center rounded-3 shadow-sm showtime-button-card">
                                        <div class="fw-bold fs-4 text-white">
                                            @st.StartTime.ToString("HH:mm")
                                        </div>
                                        <div class="text-secondary small mb-2">
                                            ~ @st.EndTime.ToString("HH:mm")
                                        </div>
                                        <div class="badge bg-dark border border-secondary text-info mb-2 text-truncate" title="@st.RoomName (@st.ScreenType)">
                                            <i class="bi bi-door-open me-1"></i>@st.RoomName
                                            @if (!string.IsNullOrEmpty(st.ScreenType))
                                            {
                                                <span>(@st.ScreenType)</span>
                                            }
                                        </div>
                                        <div class="text-warning fw-bold small mb-2">
                                            @st.BasePrice.ToString("N0") đ
                                        </div>
                                        <div class="btn btn-sm btn-outline-danger w-100 py-1 fw-semibold">
                                            <i class="bi bi-grid-3x3-gap me-1"></i> Chọn Ghế
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x fs-1 text-secondary d-block mb-3"></i>
                <h5 class="text-white fw-bold mb-2">Chưa có lịch chiếu khả dụng</h5>
                <p class="text-secondary small mb-4">Hiện tại bộ phim này chưa có lịch chiếu nào được mở bán trên hệ thống. Quý khách vui lòng quay lại sau.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Khám phá các phim khác
                </a>
            </div>
        }
    </div>

    <div class="row g-5">
        <!-- Tóm tắt nội dung -->
        <div class="col-lg-8">
            <h4 class="text-white fw-bold mb-3 border-start border-4 border-danger ps-3">
                Nội Dung Phim
            </h4>
            <div class="text-light opacity-85 lh-lg mb-5" style="font-size: 1.05rem;">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p style="white-space: pre-line;">@Model.Description</p>
                }
                else
                {
                    <p class="text-white-50 fst-italic">Thông tin tóm tắt nội dung của phim đang được ban biên tập cập nhật.</p>
                }
            </div>

            <!-- Khung xem Trailer Video -->
            @if (!string.IsNullOrEmpty(embedTrailerUrl))
            {
                <div id="trailerSection" class="mb-5">
                    <h4 class="text-white fw-bold mb-3 border-start border-4 border-danger ps-3">
                        Trailer Phim
                    </h4>
                    <div class="ratio ratio-16x9 rounded-4 overflow-hidden shadow-lg border border-secondary border-opacity-25">
                        <iframe src="@embedTrailerUrl" 
                                title="Trailer @Model.Title" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen></iframe>
                    </div>
                </div>
            }
        </div>

        <!-- Cột Phải: Quy định & Ưu đãi -->
        <div class="col-lg-4">
            <div class="p-4 rounded-4 bg-dark border border-secondary border-opacity-25 shadow-sm">
                <h5 class="text-white fw-bold mb-3">
                    <i class="bi bi-shield-exclamation text-warning me-2"></i> Lưu Ý Quan Trọng
                </h5>
                <ul class="text-white-50 small mb-0 ps-3 lh-lg">
                    <li>Vui lòng đến trước giờ chiếu ít nhất 15 phút để lấy vé và vào phòng chiếu.</li>
                    <li>Phim có phân loại độ tuổi, vui lòng mang theo giấy tờ tùy thân có ảnh khi nhận vé tại rạp.</li>
                    <li>Không mang thức ăn, đồ uống bên ngoài vào phòng chiếu.</li>
                    <li>Vé đã đặt thành công không áp dụng hoàn tiền hoặc hủy vé theo quy định.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .showtime-button-card {
        transition: all 0.25s ease-in-out;
        border-color: rgba(255, 255, 255, 0.15) !important;
        cursor: pointer;
    }
    .showtime-button-card:hover {
        border-color: #dc3545 !important;
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(220, 53, 69, 0.3) !important;
        background: rgba(220, 53, 69, 0.1) !important;
    }
    .showtime-button-card:hover .btn-outline-danger {
        background-color: #dc3545;
        color: #ffffff;
    }
    #showtimeDateTabs .nav-link {
        background-color: rgba(255, 255, 255, 0.05);
        color: #e0e0e0;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.2s ease;
    }
    #showtimeDateTabs .nav-link.active {
        background-color: #dc3545;
        color: #ffffff;
        border-color: #dc3545;
    }
    #showtimeDateTabs .nav-link.active .text-secondary {
        color: rgba(255, 255, 255, 0.8) !important;
    }
</style>
