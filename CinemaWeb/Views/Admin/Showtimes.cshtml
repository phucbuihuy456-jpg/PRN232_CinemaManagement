@model CinemaWeb.Models.AdminShowtimesListViewModel
@{
    ViewData["Title"] = "Quản lý Suất chiếu";
    Layout = "_AdminLayout";
}

<!-- Top Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1">
            <i class="bi bi-calendar2-week text-primary me-2"></i>Quản Lý Suất Chiếu
        </h3>
        <p class="text-secondary mb-0">Theo dõi, kiểm tra sơ đồ ghế và phân bổ lịch chiếu các phòng (Dữ liệu thực từ CSDL)</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary d-flex align-items-center shadow" id="btnOpenCreateShowtime" data-bs-toggle="modal" data-bs-target="#createShowtimeModal">
                <i class="bi bi-plus-circle-fill me-2"></i> Tạo Suất Chiếu Mới
            </button>
        </div>
    }
</div>

<!-- 3 Thống kê nhanh (KPI Summary) -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Tổng số suất chiếu</span>
                    <h3 class="fw-bold text-white mb-0 mt-1">@Model.Showtimes.Count</h3>
                </div>
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-4">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Đang & Sắp chiếu</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.Showtimes.Count(s => !s.IsEnded)</h3>
                </div>
                <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-4">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Đã kết thúc</span>
                    <h3 class="fw-bold text-secondary mb-0 mt-1">@Model.Showtimes.Count(s => s.IsEnded)</h3>
                </div>
                <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary p-3 fs-4">
                    <i class="bi bi-check2-all"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm suất chiếu (Filter Bar) -->
<div class="card admin-card mb-4">
    <div class="card-body py-3">
        <form method="get" asp-controller="Admin" asp-action="Showtimes" class="row g-2 align-items-center">
            <!-- Lọc theo Phim -->
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-dark text-secondary border-secondary">
                        <i class="bi bi-film"></i>
                    </span>
                    <select name="movieId" class="form-select bg-dark text-white border-secondary">
                        <option value="">-- Tất cả các bộ phim --</option>
                        @foreach (var m in Model.Movies)
                        {
                            <option value="@m.Id" selected="@(Model.SelectedMovieId == m.Id)">
                                @m.Title (@m.DurationMinutes phút)
                            </option>
                        }
                    </select>
                </div>
            </div>

            <!-- Lọc theo Ngày -->
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-dark text-secondary border-secondary">
                        <i class="bi bi-calendar"></i>
                    </span>
                    <input type="date" 
                           name="date" 
                           class="form-control bg-dark text-white border-secondary" 
                           value="@Model.SelectedDate" 
                           placeholder="Chọn ngày chiếu" />
                </div>
            </div>

            <!-- Nút bấm -->
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1 d-flex align-items-center justify-content-center">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc dữ liệu
                </button>
                @if (Model.SelectedMovieId.HasValue || !string.IsNullOrEmpty(Model.SelectedDate))
                {
                    <a asp-action="Showtimes" class="btn btn-sm btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Main Showtimes Container -->
<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold text-white">
            <i class="bi bi-list-stars text-primary me-2"></i>Danh Sách Suất Chiếu (@Model.Showtimes.Count suất)
        </span>
        <span class="badge bg-primary">Kết nối API trực tiếp</span>
    </div>

    <div class="card-body">
        @if (Model.Showtimes != null && Model.Showtimes.Any())
        {
            <div class="row g-3">
                @foreach (var st in Model.Showtimes)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card bg-black border border-secondary border-opacity-50 h-100 p-3 rounded-3 shadow-sm hover-border-primary transition-all">
                            <div class="d-flex gap-3">
                                <!-- Movie Poster Thumbnail -->
                                <img src="@(string.IsNullOrEmpty(st.PosterUrl) ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500" : st.PosterUrl)" 
                                     alt="@st.MovieTitle" 
                                     class="rounded shadow-sm" 
                                     style="width: 75px; height: 105px; object-fit: cover;" />

                                <!-- Showtime Details -->
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-secondary font-monospace" style="font-size: 0.75rem;">#@st.Id</span>
                                        @if (st.IsOngoing)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-play-circle-fill me-1"></i>Đang chiếu</span>
                                        }
                                        else if (st.IsUpcoming)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-clock-history me-1"></i>Sắp chiếu</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-check2 me-1"></i>Đã qua</span>
                                        }
                                    </div>

                                    <h5 class="text-white fw-bold mb-1 text-truncate" title="@st.MovieTitle">
                                        @st.MovieTitle
                                    </h5>

                                    <div class="text-secondary small mb-1">
                                        <i class="bi bi-door-open-fill text-warning me-1"></i>
                                        <strong class="text-light">@st.RoomName</strong>
                                        @if (!string.IsNullOrEmpty(st.ScreenType))
                                        {
                                            <span class="badge bg-dark border border-secondary text-info ms-1">@st.ScreenType</span>
                                        }
                                    </div>

                                    <div class="text-secondary small mb-1">
                                        <i class="bi bi-clock-fill text-info me-1"></i>
                                        <strong class="text-white">@st.StartTime.ToString("HH:mm")</strong> ~ @st.EndTime.ToString("HH:mm")
                                        <span class="text-secondary ms-1">(@st.StartTime.ToString("dd/MM/yyyy"))</span>
                                    </div>

                                    <div class="text-warning small fw-bold">
                                        <i class="bi bi-tag-fill me-1"></i>Giá vé: @st.BasePrice.ToString("N0") đ
                                    </div>
                                </div>
                            </div>

                            <!-- Bottom Action Buttons -->
                            <div class="mt-3 pt-2 border-top border-secondary border-opacity-50 d-flex gap-2">
                                <a asp-controller="Booking" asp-action="SeatMap" asp-route-id="@st.Id" target="_blank" class="btn btn-sm btn-outline-danger flex-grow-1">
                                    <i class="bi bi-grid-3x3-gap me-1"></i> Sơ đồ ghế
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-secondary text-danger btn-delete-showtime" 
                                            data-id="@st.Id" 
                                            data-title="@st.MovieTitle" 
                                            data-time="@st.StartTime.ToString("HH:mm dd/MM/yyyy")"
                                            title="Xóa suất chiếu này">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x fs-1 text-secondary d-block mb-3"></i>
                <h5 class="text-white fw-bold mb-1">Không có suất chiếu nào</h5>
                <p class="text-secondary small mb-3">Chưa có suất chiếu nào trong CSDL phù hợp với bộ lọc hiện tại.</p>
                <a asp-action="Showtimes" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-arrow-repeat me-1"></i> Tải lại tất cả suất chiếu
                </a>
            </div>
        }
    </div>
</div>

<!-- MODAL: TẠO SUẤT CHIẾU MỚI (Admin) -->
<div class="modal fade" id="createShowtimeModal" tabindex="-1" aria-labelledby="createShowtimeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary bg-black">
                <h5 class="modal-title text-white fw-bold" id="createShowtimeModalLabel">
                    <i class="bi bi-calendar-plus text-primary me-2"></i>Thêm Suất Chiếu Mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Alert thông báo lỗi trong modal -->
                <div id="modalAlert" class="alert alert-danger d-none py-2 px-3 small mb-3"></div>

                <form id="createShowtimeForm">
                    <!-- 1. Chọn Phim -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">1. CHỌN BỘ PHIM <span class="text-danger">*</span></label>
                        <select id="modalMovieId" class="form-select bg-black text-white border-secondary" required>
                            <option value="">-- Chọn phim chiếu --</option>
                            @foreach (var m in Model.Movies)
                            {
                                <option value="@m.Id" data-duration="@m.DurationMinutes">
                                    @m.Title (@m.DurationMinutes phút)
                                </option>
                            }
                        </select>
                    </div>

                    <!-- 2. Chọn Phòng Chiếu -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">2. PHÒNG CHIẾU <span class="text-danger">*</span></label>
                        <select id="modalRoomId" class="form-select bg-black text-white border-secondary" required>
                            <option value="">-- Chọn phòng chiếu --</option>
                            @foreach (var r in Model.Rooms)
                            {
                                <option value="@r.Id">
                                    @r.Name (@r.ScreenType - @r.TotalSeats ghế)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- 3. Giờ Bắt Đầu -->
                        <div class="col-sm-6">
                            <label class="form-label text-secondary small fw-bold">3. GIỜ BẮT ĐẦU <span class="text-danger">*</span></label>
                            <input type="datetime-local" 
                                   id="modalStartTime" 
                                   class="form-control bg-black text-white border-secondary" 
                                   value="@DateTime.Today.AddDays(1).AddHours(14).ToString("yyyy-MM-ddTHH:mm")"
                                   required />
                        </div>

                        <!-- 4. Giờ Kết Thúc (Tự động tính) -->
                        <div class="col-sm-6">
                            <label class="form-label text-secondary small fw-bold">4. GIỜ KẾT THÚC <small class="text-info">(Tự tính)</small></label>
                            <input type="datetime-local" 
                                   id="modalEndTime" 
                                   class="form-control bg-dark text-white-50 border-secondary" 
                                   readonly />
                        </div>
                    </div>

                    <!-- 5. Giá Vé Cơ Bản -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">5. GIÁ VÉ GỐC (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" 
                                   id="modalBasePrice" 
                                   class="form-control bg-black text-white border-secondary" 
                                   value="85000" 
                                   min="0" 
                                   step="5000" 
                                   required />
                            <span class="input-group-text bg-dark text-secondary border-secondary">VNĐ</span>
                        </div>
                        <small class="text-secondary" style="font-size: 0.75rem;">Phụ thu ghế VIP (+20.000đ), Couple (+40.000đ) sẽ tự động cộng thêm khi khách chọn ghế.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary bg-black py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-sm btn-primary px-4 fw-semibold" id="btnSubmitCreate">
                    <i class="bi bi-check-circle-fill me-1"></i> Lưu & Tạo Suất Chiếu
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-border-primary {
        transition: all 0.25s ease-in-out;
    }
    .hover-border-primary:hover {
        border-color: #0d6efd !important;
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(13, 110, 253, 0.2) !important;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalMovieId = document.getElementById('modalMovieId');
            const modalStartTime = document.getElementById('modalStartTime');
            const modalEndTime = document.getElementById('modalEndTime');
            const modalRoomId = document.getElementById('modalRoomId');
            const modalBasePrice = document.getElementById('modalBasePrice');
            const btnSubmitCreate = document.getElementById('btnSubmitCreate');
            const modalAlert = document.getElementById('modalAlert');

            // Tự động tính Giờ kết thúc = Giờ bắt đầu + Thời lượng phim + 15 phút dọn phòng
            function calculateEndTime() {
                if (!modalMovieId || !modalStartTime || !modalEndTime) return;
                const selectedOpt = modalMovieId.options[modalMovieId.selectedIndex];
                const duration = parseInt(selectedOpt?.getAttribute('data-duration') || '0', 10);
                const startTimeVal = modalStartTime.value;

                if (duration > 0 && startTimeVal) {
                    const start = new Date(startTimeVal);
                    // Thời lượng phim + 15 phút nghỉ / dọn rạp
                    const end = new Date(start.getTime() + (duration + 15) * 60000);

                    const pad = (n) => n < 10 ? '0' + n : n;
                    const formattedEnd = `${end.getFullYear()}-${pad(end.getMonth() + 1)}-${pad(end.getDate())}T${pad(end.getHours())}:${pad(end.getMinutes())}`;
                    modalEndTime.value = formattedEnd;
                }
            }

            modalMovieId?.addEventListener('change', calculateEndTime);
            modalStartTime?.addEventListener('input', calculateEndTime);
            calculateEndTime();

            // 1. XỬ LÝ TẠO SUẤT CHIẾU MỚI (POST)
            btnSubmitCreate?.addEventListener('click', async function () {
                modalAlert.classList.add('d-none');
                modalAlert.innerHTML = '';

                const movieId = parseInt(modalMovieId.value, 10);
                const roomId = parseInt(modalRoomId.value, 10);
                const startTime = modalStartTime.value;
                const endTime = modalEndTime.value;
                const basePrice = parseFloat(modalBasePrice.value);

                if (!movieId || !roomId || !startTime || !endTime) {
                    showModalError('Vui lòng điền đầy đủ tất cả các trường thông tin bắt buộc.');
                    return;
                }

                if (new Date(startTime) <= new Date()) {
                    showModalError('Thời gian bắt đầu suất chiếu phải ở tương lai.');
                    return;
                }

                const payload = {
                    movieId: movieId,
                    roomId: roomId,
                    startTime: startTime,
                    endTime: endTime,
                    basePrice: basePrice
                };

                const origText = btnSubmitCreate.innerHTML;
                btnSubmitCreate.disabled = true;
                btnSubmitCreate.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang tạo...';

                try {
                    const response = await fetch('/Admin/CreateShowtime', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json();

                    if (response.ok) {
                        alert('Tạo suất chiếu mới thành công!');
                        window.location.reload();
                    } else {
                        showModalError(data.message || 'Không thể tạo suất chiếu. Vui lòng kiểm tra lại!');
                        btnSubmitCreate.disabled = false;
                        btnSubmitCreate.innerHTML = origText;
                    }
                } catch (err) {
                    console.error('Lỗi khi gọi API CreateShowtime:', err);
                    showModalError('Lỗi kết nối tới máy chủ khi tạo suất chiếu.');
                    btnSubmitCreate.disabled = false;
                    btnSubmitCreate.innerHTML = origText;
                }
            });

            function showModalError(msg) {
                modalAlert.textContent = msg;
                modalAlert.classList.remove('d-none');
            }

            // 2. XỬ LÝ XÓA SUẤT CHIẾU (DELETE)
            document.querySelectorAll('.btn-delete-showtime').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const id = this.getAttribute('data-id');
                    const title = this.getAttribute('data-title');
                    const time = this.getAttribute('data-time');

                    const confirmMsg = `Bạn có chắc chắn muốn xóa suất chiếu #${id}?\n\nPhim: ${title}\nKhung giờ: ${time}\n\n(Lưu ý: Chỉ xóa được nếu chưa có khách hàng nào mua vé)`;
                    if (!confirm(confirmMsg)) return;

                    const origHtml = this.innerHTML;
                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                    try {
                        const response = await fetch(`/Admin/DeleteShowtime?id=${id}`, {
                            method: 'POST'
                        });

                        const data = await response.json();

                        if (response.ok) {
                            alert(data.message || 'Xóa suất chiếu thành công!');
                            window.location.reload();
                        } else {
                            alert(data.message || 'Không thể xóa suất chiếu này.');
                            this.disabled = false;
                            this.innerHTML = origHtml;
                        }
                    } catch (err) {
                        console.error('Lỗi khi xóa suất chiếu:', err);
                        alert('Đã xảy ra lỗi kết nối khi gửi yêu cầu xóa.');
                        this.disabled = false;
                        this.innerHTML = origHtml;
                    }
                });
            });
        });
    </script>
}
