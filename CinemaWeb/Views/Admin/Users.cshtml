@{
    ViewData["Title"] = "Quản lý Người dùng & Phân quyền";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1"><i class="bi bi-people text-success me-2"></i>Quản Lý Người Dùng & Phân Quyền</h3>
        <p class="text-secondary mb-0">Chỉ tài khoản Quản Trị Viên (Admin) mới có quyền truy cập trang này</p>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-person-lines-fill me-2"></i>Danh Sách Tài Khoản Hệ Thống</span>
        <span class="badge bg-danger">Chỉ Admin truy cập</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th>Họ Và Tên</th>
                        <th>Email</th>
                        <th>Số Điện Thoại</th>
                        <th>Vai Trò (Role)</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-white">Quản Trị Viên</td>
                        <td>admin@cinema.com</td>
                        <td>0901234567</td>
                        <td><span class="badge bg-danger">Admin</span></td>
                        <td><span class="badge bg-success">Hoạt động</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-white">Nhân Viên Bán Vé</td>
                        <td>staff@cinema.com</td>
                        <td>0912345678</td>
                        <td><span class="badge bg-warning text-dark">Staff</span></td>
                        <td><span class="badge bg-success">Hoạt động</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-white">Nguyễn Văn Khách</td>
                        <td>customer@gmail.com</td>
                        <td>0987654321</td>
                        <td><span class="badge bg-secondary">Customer</span></td>
                        <td><span class="badge bg-success">Hoạt động</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
