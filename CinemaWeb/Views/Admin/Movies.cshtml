@model CinemaWeb.Models.AdminMoviesListViewModel
@{
    ViewData["Title"] = "Quản lý Phim";
    Layout = "_AdminLayout";
}

<!-- Top Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1">
            <i class="bi bi-film text-danger me-2"></i>Quản Lý Danh Mục Phim
        </h3>
        <p class="text-secondary mb-0">Theo dõi, cập nhật thông tin và quản lý các bộ phim trong CSDL hệ thống (Quyền: Admin)</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-danger d-flex align-items-center shadow" id="btnOpenCreateMovie" data-bs-toggle="modal" data-bs-target="#movieModal">
                <i class="bi bi-plus-circle-fill me-2"></i> Thêm Phim Mới
            </button>
        </div>
    }
</div>

<!-- 3 Thống kê nhanh (KPI Summary) -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Tổng số phim</span>
                    <h3 class="fw-bold text-white mb-0 mt-1">@Model.Movies.Count</h3>
                </div>
                <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 fs-4">
                    <i class="bi bi-collection-play"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Phim đang chiếu</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.Movies.Count(m => m.IsNowShowing)</h3>
                </div>
                <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-4">
                    <i class="bi bi-play-circle"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Phim sắp chiếu</span>
                    <h3 class="fw-bold text-info mb-0 mt-1">@Model.Movies.Count(m => m.IsComingSoon)</h3>
                </div>
                <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 fs-4">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm phim (Filter Bar) -->
<div class="card admin-card mb-4">
    <div class="card-body py-3">
        <form method="get" asp-controller="Admin" asp-action="Movies" class="row g-2 align-items-center">
            <!-- Tìm theo từ khóa -->
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-dark text-secondary border-secondary">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" 
                           name="search" 
                           class="form-control bg-dark text-white border-secondary" 
                           value="@Model.SearchKeyword" 
                           placeholder="Tìm tên phim, đạo diễn hoặc diễn viên..." />
                </div>
            </div>

            <!-- Lọc theo Thể loại -->
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-dark text-secondary border-secondary">
                        <i class="bi bi-tags"></i>
                    </span>
                    <select name="genreId" class="form-select bg-dark text-white border-secondary">
                        <option value="">-- Tất cả thể loại --</option>
                        @foreach (var g in Model.Genres)
                        {
                            <option value="@g.Id" selected="@(Model.SelectedGenreId == g.Id)">
                                @g.Name
                            </option>
                        }
                    </select>
                </div>
            </div>

            <!-- Nút bấm -->
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-danger flex-grow-1 d-flex align-items-center justify-content-center">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc phim
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchKeyword) || Model.SelectedGenreId.HasValue)
                {
                    <a asp-action="Movies" class="btn btn-sm btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Main Movies Table Container -->
<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold text-white">
            <i class="bi bi-list-stars text-danger me-2"></i>Danh Sách Phim Trong Hệ Thống (@Model.Movies.Count phim)
        </span>
        <span class="badge bg-danger">Kết nối API trực tiếp</span>
    </div>

    <div class="card-body p-0">
        @if (Model.Movies != null && Model.Movies.Any())
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-secondary small text-uppercase">
                            <th style="width: 75px;" class="text-center">Poster</th>
                            <th>Tên Phim & Thể Loại</th>
                            <th>Đạo Diễn & Diễn Viên</th>
                            <th>Thời Lượng & Độ Tuổi</th>
                            <th>Lịch Chiếu</th>
                            <th>Trạng Thái</th>
                            <th style="width: 160px;" class="text-end pe-3">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Movies)
                        {
                            var ageClass = m.AgeRating switch
                            {
                                "P" => "bg-success",
                                "C13" => "bg-warning text-dark",
                                "C16" => "bg-orange text-white",
                                "C18" => "bg-danger",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <!-- 1. Poster -->
                                <td class="text-center py-2">
                                    <img src="@(string.IsNullOrEmpty(m.PosterUrl) ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500" : m.PosterUrl)" 
                                         alt="@m.Title" 
                                         class="rounded shadow-sm" 
                                         style="width: 48px; height: 68px; object-fit: cover;" />
                                </td>

                                <!-- 2. Tên phim & Thể loại -->
                                <td>
                                    <div class="fw-bold text-white fs-6">@m.Title</div>
                                    <div class="text-secondary small">
                                        <i class="bi bi-tags-fill text-warning me-1"></i>@m.GenreDisplay
                                    </div>
                                    @if (!string.IsNullOrEmpty(m.TrailerUrl))
                                    {
                                        <a href="@m.TrailerUrl" target="_blank" class="small text-danger text-decoration-none">
                                            <i class="bi bi-youtube me-1"></i>Xem Trailer
                                        </a>
                                    }
                                </td>

                                <!-- 3. Đạo diễn & Diễn viên -->
                                <td>
                                    <div class="text-light small">
                                        <span class="text-secondary">ĐD:</span> @(string.IsNullOrEmpty(m.Director) ? "Chưa cập nhật" : m.Director)
                                    </div>
                                    <div class="text-secondary small text-truncate" style="max-width: 200px;" title="@m.Cast">
                                        <span>DV:</span> @(string.IsNullOrEmpty(m.Cast) ? "Chưa cập nhật" : m.Cast)
                                    </div>
                                </td>

                                <!-- 4. Thời lượng & Độ tuổi -->
                                <td>
                                    <div class="fw-semibold text-white small">@m.DurationMinutes phút</div>
                                    <span class="badge @ageClass font-monospace" style="font-size: 0.75rem;">
                                        @(string.IsNullOrEmpty(m.AgeRating) ? "P" : m.AgeRating)
                                    </span>
                                    @if (!string.IsNullOrEmpty(m.Language))
                                    {
                                        <span class="badge bg-dark border border-secondary text-info ms-1" style="font-size: 0.7rem;">@m.Language</span>
                                    }
                                </td>

                                <!-- 5. Khoảng ngày chiếu -->
                                <td class="small">
                                    <div class="text-light">
                                        <i class="bi bi-calendar-check text-success me-1"></i>@m.ReleaseDate.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="text-secondary">
                                        <i class="bi bi-calendar-x text-danger me-1"></i>@m.EndDate.ToString("dd/MM/yyyy")
                                    </div>
                                </td>

                                <!-- 6. Trạng thái -->
                                <td>
                                    @if (m.IsNowShowing)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                            <i class="bi bi-play-circle-fill me-1"></i>Đang chiếu
                                        </span>
                                    }
                                    else if (m.IsComingSoon)
                                    {
                                        <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50">
                                            <i class="bi bi-clock-history me-1"></i>Sắp chiếu
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary">
                                            <i class="bi bi-check2-all me-1"></i>Đã kết thúc
                                        </span>
                                    }
                                </td>

                                <!-- 7. Hành động -->
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Showtimes" asp-route-movieId="@m.Id" class="btn btn-sm btn-outline-primary" title="Xem & Xếp lịch chiếu">
                                            <i class="bi bi-calendar2-week"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-warning btn-edit-movie" 
                                                    data-id="@m.Id" 
                                                    title="Sửa thông tin phim">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-danger btn-delete-movie" 
                                                    data-id="@m.Id" 
                                                    data-title="@m.Title" 
                                                    title="Xóa bộ phim này">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-film fs-1 text-secondary d-block mb-3"></i>
                <h5 class="text-white fw-bold mb-1">Không có phim nào</h5>
                <p class="text-secondary small mb-3">Chưa có bộ phim nào trong CSDL phù hợp với điều kiện tìm kiếm.</p>
                <a asp-action="Movies" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                    <i class="bi bi-arrow-repeat me-1"></i> Tải lại danh sách phim
                </a>
            </div>
        }
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: THÊM MỚI / CHỈNH SỬA PHIM (Admin)   -->
<!-- ========================================== -->
<div class="modal fade" id="movieModal" tabindex="-1" aria-labelledby="movieModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary bg-black">
                <h5 class="modal-title text-white fw-bold" id="movieModalLabel">
                    <i class="bi bi-film text-danger me-2"></i>Thêm Phim Mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Alert thông báo lỗi trong modal -->
                <div id="modalMovieAlert" class="alert alert-danger d-none py-2 px-3 small mb-3"></div>

                <form id="movieForm">
                    <input type="hidden" id="modalMovieId" value="" />

                    <div class="row g-3 mb-3">
                        <!-- 1. Tên Phim -->
                        <div class="col-md-8">
                            <label class="form-label text-secondary small fw-bold">TÊN BỘ PHIM <span class="text-danger">*</span></label>
                            <input type="text" id="modalTitle" class="form-control bg-black text-white border-secondary" placeholder="Ví dụ: Deadpool & Wolverine" required />
                        </div>

                        <!-- 2. Độ tuổi -->
                        <div class="col-md-4">
                            <label class="form-label text-secondary small fw-bold">GIỚI HẠN ĐỘ TUỔI <span class="text-danger">*</span></label>
                            <select id="modalAgeRating" class="form-select bg-black text-white border-secondary" required>
                                <option value="P">P - Mọi độ tuổi</option>
                                <option value="C13">C13 - Cấm dưới 13 tuổi</option>
                                <option value="C16">C16 - Cấm dưới 16 tuổi</option>
                                <option value="C18">C18 - Cấm dưới 18 tuổi</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- 3. Thời lượng -->
                        <div class="col-sm-4">
                            <label class="form-label text-secondary small fw-bold">THỜI LƯỢNG (PHÚT) <span class="text-danger">*</span></label>
                            <input type="number" id="modalDuration" class="form-control bg-black text-white border-secondary" placeholder="Ví dụ: 125" min="1" required />
                        </div>

                        <!-- 4. Ngôn ngữ -->
                        <div class="col-sm-4">
                            <label class="form-label text-secondary small fw-bold">NGÔN NGỮ</label>
                            <input type="text" id="modalLanguage" class="form-control bg-black text-white border-secondary" value="Phụ đề Tiếng Việt" placeholder="Ví dụ: Tiếng Anh - Phụ đề TV" />
                        </div>

                        <!-- 5. Đạo diễn -->
                        <div class="col-sm-4">
                            <label class="form-label text-secondary small fw-bold">ĐẠO DIỄN</label>
                            <input type="text" id="modalDirector" class="form-control bg-black text-white border-secondary" placeholder="Ví dụ: Shawn Levy" />
                        </div>
                    </div>

                    <!-- 6. Diễn viên -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">DIỄN VIÊN CHÍNH</label>
                        <input type="text" id="modalCast" class="form-control bg-black text-white border-secondary" placeholder="Ví dụ: Ryan Reynolds, Hugh Jackman..." />
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- 7. Ngày khởi chiếu -->
                        <div class="col-sm-6">
                            <label class="form-label text-secondary small fw-bold">NGÀY KHỞI CHIẾU <span class="text-danger">*</span></label>
                            <input type="date" id="modalReleaseDate" class="form-control bg-black text-white border-secondary" required />
                        </div>

                        <!-- 8. Ngày ngừng chiếu -->
                        <div class="col-sm-6">
                            <label class="form-label text-secondary small fw-bold">NGÀY DỰ KIẾN KẾT THÚC <span class="text-danger">*</span></label>
                            <input type="date" id="modalEndDate" class="form-control bg-black text-white border-secondary" required />
                        </div>
                    </div>

                    <!-- 9. Danh mục Thể loại -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold d-block">THỂ LOẠI PHIM <span class="text-danger">*</span></label>
                        <div class="p-3 bg-black border border-secondary rounded d-flex flex-wrap gap-3" id="genreCheckboxContainer">
                            @foreach (var g in Model.Genres)
                            {
                                <div class="form-check">
                                    <input class="form-check-input genre-check" type="checkbox" value="@g.Id" id="genre_@g.Id" />
                                    <label class="form-check-label text-light small" for="genre_@g.Id">
                                        @g.Name
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- 10. Poster URL -->
                        <div class="col-sm-8">
                            <label class="form-label text-secondary small fw-bold">ĐƯỜNG DẪN POSTER (IMAGE URL)</label>
                            <input type="url" id="modalPosterUrl" class="form-control bg-black text-white border-secondary" placeholder="https://..." />
                        </div>
                        <!-- Preview Thumbnail -->
                        <div class="col-sm-4 text-center">
                            <label class="form-label text-secondary small fw-bold d-block">XEM TRƯỚC POSTER</label>
                            <img id="posterPreview" src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500" class="rounded shadow-sm" style="width: 60px; height: 85px; object-fit: cover;" alt="Preview" />
                        </div>
                    </div>

                    <!-- 11. Trailer URL -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">ĐƯỜNG DẪN TRAILER (YOUTUBE LINK)</label>
                        <input type="url" id="modalTrailerUrl" class="form-control bg-black text-white border-secondary" placeholder="https://www.youtube.com/watch?v=..." />
                    </div>

                    <!-- 12. Mô tả nội dung -->
                    <div class="mb-2">
                        <label class="form-label text-secondary small fw-bold">MÔ TẢ TÓM TẮT NỘI DUNG</label>
                        <textarea id="modalDescription" class="form-control bg-black text-white border-secondary" rows="3" placeholder="Nhập tóm tắt cốt truyện phim..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary bg-black py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-sm btn-danger px-4 fw-semibold" id="btnSubmitMovie">
                    <i class="bi bi-check-circle-fill me-1"></i> <span id="btnSubmitMovieText">Lưu & Thêm Phim</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-orange {
        background-color: #fd7e14 !important;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const movieModal = new bootstrap.Modal(document.getElementById('movieModal'));
            const modalMovieLabel = document.getElementById('movieModalLabel');
            const modalMovieAlert = document.getElementById('modalMovieAlert');
            const btnOpenCreateMovie = document.getElementById('btnOpenCreateMovie');
            const btnSubmitMovie = document.getElementById('btnSubmitMovie');
            const btnSubmitMovieText = document.getElementById('btnSubmitMovieText');

            // Form inputs
            const modalMovieId = document.getElementById('modalMovieId');
            const modalTitle = document.getElementById('modalTitle');
            const modalAgeRating = document.getElementById('modalAgeRating');
            const modalDuration = document.getElementById('modalDuration');
            const modalLanguage = document.getElementById('modalLanguage');
            const modalDirector = document.getElementById('modalDirector');
            const modalCast = document.getElementById('modalCast');
            const modalReleaseDate = document.getElementById('modalReleaseDate');
            const modalEndDate = document.getElementById('modalEndDate');
            const modalPosterUrl = document.getElementById('modalPosterUrl');
            const posterPreview = document.getElementById('posterPreview');
            const modalTrailerUrl = document.getElementById('modalTrailerUrl');
            const modalDescription = document.getElementById('modalDescription');

            // Cập nhật xem trước ảnh Poster khi gõ URL
            modalPosterUrl?.addEventListener('input', function () {
                const val = this.value.trim();
                posterPreview.src = val ? val : 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500';
            });

            // 1. MỞ MODAL THÊM PHIM MỚI
            btnOpenCreateMovie?.addEventListener('click', function () {
                modalMovieLabel.innerHTML = '<i class="bi bi-film text-danger me-2"></i>Thêm Phim Mới';
                btnSubmitMovieText.textContent = 'Lưu & Thêm Phim';
                modalMovieAlert.classList.add('d-none');
                modalMovieAlert.textContent = '';

                // Reset form
                modalMovieId.value = '';
                modalTitle.value = '';
                modalAgeRating.value = 'P';
                modalDuration.value = 120;
                modalLanguage.value = 'Phụ đề Tiếng Việt';
                modalDirector.value = '';
                modalCast.value = '';

                // Mặc định: Ngày khởi chiếu hôm nay, ngày kết thúc sau 30 ngày
                const today = new Date();
                const pad = (n) => n < 10 ? '0' + n : n;
                modalReleaseDate.value = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;

                const endDateObj = new Date();
                endDateObj.setDate(endDateObj.getDate() + 30);
                modalEndDate.value = `${endDateObj.getFullYear()}-${pad(endDateObj.getMonth() + 1)}-${pad(endDateObj.getDate())}`;

                modalPosterUrl.value = '';
                posterPreview.src = 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500';
                modalTrailerUrl.value = '';
                modalDescription.value = '';

                // Bỏ chọn tất cả thể loại
                document.querySelectorAll('.genre-check').forEach(chk => chk.checked = false);
            });

            // 2. MỞ MODAL CHỈNH SỬA PHIM (EDIT)
            document.querySelectorAll('.btn-edit-movie').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const id = this.getAttribute('data-id');
                    modalMovieAlert.classList.add('d-none');
                    modalMovieAlert.textContent = '';

                    modalMovieLabel.innerHTML = `<i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh Sửa Phim #${id}`;
                    btnSubmitMovieText.textContent = 'Lưu Thay Đổi';

                    try {
                        const res = await fetch(`/Admin/GetMovieDetail?id=${id}`);
                        if (!res.ok) {
                            alert('Không thể tải thông tin bộ phim!');
                            return;
                        }

                        const data = await res.json();
                        modalMovieId.value = data.id;
                        modalTitle.value = data.title || '';
                        modalAgeRating.value = data.ageRating || 'P';
                        modalDuration.value = data.durationMinutes || 0;
                        modalLanguage.value = data.language || '';
                        modalDirector.value = data.director || '';
                        modalCast.value = data.cast || '';
                        modalReleaseDate.value = data.releaseDate ? data.releaseDate : '';
                        modalEndDate.value = data.endDate ? data.endDate : '';
                        modalPosterUrl.value = data.posterUrl || '';
                        posterPreview.src = data.posterUrl ? data.posterUrl : 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500';
                        modalTrailerUrl.value = data.trailerUrl || '';
                        modalDescription.value = data.description || '';

                        // Đánh dấu thể loại đã có
                        const genreIds = new Set();
                        if (data.movieGenres && Array.isArray(data.movieGenres)) {
                            data.movieGenres.forEach(mg => genreIds.add(mg.genreId));
                        }

                        document.querySelectorAll('.genre-check').forEach(chk => {
                            chk.checked = genreIds.has(parseInt(chk.value, 10));
                        });

                        movieModal.show();
                    } catch (err) {
                        console.error('Lỗi khi tải chi tiết phim:', err);
                        alert('Đã xảy ra lỗi kết nối khi tải chi tiết phim.');
                    }
                });
            });

            // 3. XỬ LÝ LƯU PHIM (CREATE HOẶC UPDATE)
            btnSubmitMovie?.addEventListener('click', async function () {
                modalMovieAlert.classList.add('d-none');
                modalMovieAlert.textContent = '';

                const id = modalMovieId.value ? parseInt(modalMovieId.value, 10) : null;
                const title = modalTitle.value.trim();
                const duration = parseInt(modalDuration.value, 10);
                const ageRating = modalAgeRating.value;
                const releaseDate = modalReleaseDate.value;
                const endDate = modalEndDate.value;

                if (!title) {
                    showError('Vui lòng nhập tên bộ phim.');
                    return;
                }
                if (!duration || duration <= 0) {
                    showError('Thời lượng phim phải lớn hơn 0 phút.');
                    return;
                }
                if (!releaseDate || !endDate) {
                    showError('Vui lòng chọn ngày khởi chiếu và ngày kết thúc.');
                    return;
                }
                if (new Date(endDate) < new Date(releaseDate)) {
                    showError('Ngày kết thúc chiếu phải lớn hơn hoặc bằng ngày khởi chiếu.');
                    return;
                }

                // Lấy danh sách GenreIds
                const selectedGenreIds = [];
                document.querySelectorAll('.genre-check:checked').forEach(chk => {
                    selectedGenreIds.push(parseInt(chk.value, 10));
                });

                if (selectedGenreIds.length === 0) {
                    showError('Vui lòng chọn ít nhất 1 thể loại cho bộ phim.');
                    return;
                }

                const payload = {
                    title: title,
                    description: modalDescription.value.trim(),
                    director: modalDirector.value.trim(),
                    cast: modalCast.value.trim(),
                    durationMinutes: duration,
                    releaseDate: releaseDate,
                    endDate: endDate,
                    posterUrl: modalPosterUrl.value.trim(),
                    trailerUrl: modalTrailerUrl.value.trim(),
                    ageRating: ageRating,
                    language: modalLanguage.value.trim(),
                    genreIds: selectedGenreIds
                };

                const isEdit = id && id > 0;
                const url = isEdit ? `/Admin/UpdateMovie?id=${id}` : '/Admin/CreateMovie';

                const origHtml = btnSubmitMovie.innerHTML;
                btnSubmitMovie.disabled = true;
                btnSubmitMovie.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...';

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json();

                    if (response.ok) {
                        alert(isEdit ? 'Cập nhật thông tin phim thành công!' : 'Thêm phim mới thành công!');
                        window.location.reload();
                    } else {
                        showError(data.message || 'Không thể lưu thông tin phim. Vui lòng kiểm tra lại!');
                        btnSubmitMovie.disabled = false;
                        btnSubmitMovie.innerHTML = origHtml;
                    }
                } catch (err) {
                    console.error('Lỗi khi lưu phim:', err);
                    showError('Lỗi kết nối tới máy chủ khi lưu phim.');
                    btnSubmitMovie.disabled = false;
                    btnSubmitMovie.innerHTML = origHtml;
                }
            });

            function showError(msg) {
                modalMovieAlert.textContent = msg;
                modalMovieAlert.classList.remove('d-none');
            }

            // 4. XỬ LÝ XÓA PHIM (DELETE)
            document.querySelectorAll('.btn-delete-movie').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const id = this.getAttribute('data-id');
                    const title = this.getAttribute('data-title');

                    const confirmMsg = `Bạn có chắc chắn muốn xóa bộ phim "${title}" (ID: #${id})?\n\n(Lưu ý: Hệ thống sẽ chặn xóa nếu phim đang có suất chiếu trong tương lai)`;
                    if (!confirm(confirmMsg)) return;

                    const origHtml = this.innerHTML;
                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                    try {
                        const response = await fetch(`/Admin/DeleteMovie?id=${id}`, {
                            method: 'POST'
                        });

                        const data = await response.json();

                        if (response.ok) {
                            alert(data.message || 'Xóa phim thành công!');
                            window.location.reload();
                        } else {
                            alert(data.message || 'Không thể xóa phim này!');
                            this.disabled = false;
                            this.innerHTML = origHtml;
                        }
                    } catch (err) {
                        console.error('Lỗi khi xóa phim:', err);
                        alert('Đã xảy ra lỗi kết nối khi gửi yêu cầu xóa phim.');
                        this.disabled = false;
                        this.innerHTML = origHtml;
                    }
                });
            });
        });
    </script>
}
