@{
    ViewData["Title"] = "Quản lý Phim";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1"><i class="bi bi-film text-danger me-2"></i>Quản Lý Phim</h3>
        <p class="text-secondary mb-0">Danh sách các bộ phim trong hệ thống rạp (Quyền: Admin)</p>
    </div>
    <button class="btn btn-danger d-flex align-items-center" disabled>
        <i class="bi bi-plus-circle me-2"></i> Thêm Phim Mới (Task 14)
    </button>
</div>

<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-ul me-2"></i>Danh Sách Phim Mẫu</span>
        <span class="badge bg-danger">Yêu cầu quyền: Admin</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th style="width: 80px;">Poster</th>
                        <th>Tên Phim</th>
                        <th>Đạo Diễn</th>
                        <th>Thời Lượng</th>
                        <th>Độ Tuổi</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500" class="rounded" style="width: 50px; height: 70px; object-fit: cover;" alt="Mai" />
                        </td>
                        <td>
                            <div class="fw-bold text-white">Mai</div>
                            <small class="text-secondary">Thể loại: Tình Cảm</small>
                        </td>
                        <td>Trấn Thành</td>
                        <td>131 phút</td>
                        <td><span class="badge bg-danger">C18</span></td>
                        <td><span class="badge bg-success">Đang chiếu</span></td>
                    </tr>
                    <tr>
                        <td>
                            <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500" class="rounded" style="width: 50px; height: 70px; object-fit: cover;" alt="Dune 2" />
                        </td>
                        <td>
                            <div class="fw-bold text-white">Dune: Hành Tinh Cát - Phần 2</div>
                            <small class="text-secondary">Thể loại: Hành Động, Khoa Học Viễn Tưởng</small>
                        </td>
                        <td>Denis Villeneuve</td>
                        <td>166 phút</td>
                        <td><span class="badge bg-warning text-dark">C13</span></td>
                        <td><span class="badge bg-success">Đang chiếu</span></td>
                    </tr>
                    <tr>
                        <td>
                            <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=500" class="rounded" style="width: 50px; height: 70px; object-fit: cover;" alt="Kung Fu Panda 4" />
                        </td>
                        <td>
                            <div class="fw-bold text-white">Kung Fu Panda 4</div>
                            <small class="text-secondary">Thể loại: Hoạt Hình, Hài Hước</small>
                        </td>
                        <td>Mike Mitchell</td>
                        <td>94 phút</td>
                        <td><span class="badge bg-success">P</span></td>
                        <td><span class="badge bg-success">Đang chiếu</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
