@{
    ViewData["Title"] = "Quản lý Thể loại Phim";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1"><i class="bi bi-tags text-info me-2"></i>Quản Lý Thể Loại Phim</h3>
        <p class="text-secondary mb-0">Danh mục thể loại phim trong rạp (Quyền: Admin)</p>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header">
        <span><i class="bi bi-tag-fill me-2"></i>Thể Loại Hiện Có</span>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <span class="badge bg-secondary p-2 fs-6">Hành Động</span>
            <span class="badge bg-secondary p-2 fs-6">Kinh Dị</span>
            <span class="badge bg-secondary p-2 fs-6">Tình Cảm</span>
            <span class="badge bg-secondary p-2 fs-6">Hoạt Hình</span>
            <span class="badge bg-secondary p-2 fs-6">Hài Hước</span>
            <span class="badge bg-secondary p-2 fs-6">Khoa Học Viễn Tưởng</span>
        </div>
    </div>
</div>
