@model CinemaWeb.Models.AdminGenresListViewModel
@{
    ViewData["Title"] = "Quản lý Thể loại Phim";
    Layout = "_AdminLayout";
}

<!-- Top Header Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1">
            <i class="bi bi-tags-fill text-info me-2"></i>Quản Lý Thể Loại Phim
        </h3>
        <p class="text-secondary mb-0">Danh mục thể loại phim phục vụ phân loại và bộ lọc tìm kiếm cho khách hàng (Quyền: Admin)</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-info text-dark fw-bold d-flex align-items-center shadow" id="btnOpenCreateGenre" data-bs-toggle="modal" data-bs-target="#genreModal">
                <i class="bi bi-plus-circle-fill me-2"></i> Thêm Thể Loại Mới
            </button>
        </div>
    }
</div>

<!-- Bộ lọc tìm kiếm Thể loại (Filter Bar) -->
<div class="card admin-card mb-4">
    <div class="card-body py-3">
        <form method="get" asp-controller="Admin" asp-action="Genres" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-dark text-secondary border-secondary">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" 
                           name="search" 
                           class="form-control bg-dark text-white border-secondary" 
                           value="@Model.SearchKeyword" 
                           placeholder="Tìm kiếm tên thể loại..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-info text-dark fw-semibold flex-grow-1 d-flex align-items-center justify-content-center">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchKeyword))
                {
                    <a asp-action="Genres" class="btn btn-sm btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Main Genres Table Container -->
<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold text-white">
            <i class="bi bi-list-stars text-info me-2"></i>Danh Sách Thể Loại (@Model.Genres.Count thể loại)
        </span>
        <span class="badge bg-info text-dark">Dữ liệu CSDL thời gian thực</span>
    </div>

    <div class="card-body p-0">
        @if (Model.Genres != null && Model.Genres.Any())
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-secondary small text-uppercase">
                            <th style="width: 80px;">ID</th>
                            <th>Tên Thể Loại</th>
                            <th>Số Lượng Phim Đang Thuộc Thể Loại</th>
                            <th style="width: 180px;" class="text-end pe-3">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.Genres)
                        {
                            <tr>
                                <td class="text-secondary font-monospace">#@g.Id</td>
                                <td>
                                    <span class="fw-bold text-white fs-6">
                                        <i class="bi bi-tag text-info me-1"></i>@g.Name
                                    </span>
                                </td>
                                <td>
                                    @if (g.MovieCount > 0)
                                    {
                                        <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-50 px-2 py-1">
                                            <i class="bi bi-film me-1"></i>@g.MovieCount bộ phim
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small fst-italic">Chưa có phim liên kết</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-warning btn-edit-genre" 
                                                data-id="@g.Id" 
                                                data-name="@g.Name"
                                                title="Sửa tên thể loại">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </button>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger btn-delete-genre" 
                                                data-id="@g.Id" 
                                                data-name="@g.Name" 
                                                data-count="@g.MovieCount"
                                                title="Xóa thể loại này">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-tags fs-1 text-secondary d-block mb-3"></i>
                <h5 class="text-white fw-bold mb-1">Chưa có thể loại nào</h5>
                <p class="text-secondary small mb-3">Không tìm thấy thể loại nào phù hợp với từ khóa.</p>
                <a asp-action="Genres" class="btn btn-sm btn-outline-info rounded-pill px-3 text-dark fw-bold">
                    <i class="bi bi-arrow-repeat me-1"></i> Tải lại danh sách
                </a>
            </div>
        }
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL: THÊM MỚI / CHỈNH SỬA THỂ LOẠI (Admin)   -->
<!-- ============================================== -->
<div class="modal fade" id="genreModal" tabindex="-1" aria-labelledby="genreModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary bg-black">
                <h5 class="modal-title text-white fw-bold" id="genreModalLabel">
                    <i class="bi bi-tags-fill text-info me-2"></i>Thêm Thể Loại Mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalGenreAlert" class="alert alert-danger d-none py-2 px-3 small mb-3"></div>

                <form id="genreForm">
                    <input type="hidden" id="modalGenreId" value="" />

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">TÊN THỂ LOẠI <span class="text-danger">*</span></label>
                        <input type="text" id="modalGenreName" class="form-control bg-black text-white border-secondary" placeholder="Ví dụ: Khoa Học Viễn Tưởng, Tâm Lý Tội Phạm..." required />
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary bg-black py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-sm btn-info text-dark px-4 fw-semibold" id="btnSubmitGenre">
                    <i class="bi bi-check-circle-fill me-1"></i> <span id="btnSubmitGenreText">Lưu Thể Loại</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const genreModal = new bootstrap.Modal(document.getElementById('genreModal'));
            const modalGenreLabel = document.getElementById('genreModalLabel');
            const modalGenreAlert = document.getElementById('modalGenreAlert');
            const btnOpenCreateGenre = document.getElementById('btnOpenCreateGenre');
            const btnSubmitGenre = document.getElementById('btnSubmitGenre');
            const btnSubmitGenreText = document.getElementById('btnSubmitGenreText');

            const modalGenreId = document.getElementById('modalGenreId');
            const modalGenreName = document.getElementById('modalGenreName');

            // 1. MỞ MODAL THÊM THỂ LOẠI
            btnOpenCreateGenre?.addEventListener('click', function () {
                modalGenreLabel.innerHTML = '<i class="bi bi-tags-fill text-info me-2"></i>Thêm Thể Loại Mới';
                btnSubmitGenreText.textContent = 'Lưu Thể Loại';
                modalGenreAlert.classList.add('d-none');
                modalGenreAlert.textContent = '';

                modalGenreId.value = '';
                modalGenreName.value = '';
            });

            // 2. MỞ MODAL SỬA THỂ LOẠI
            document.querySelectorAll('.btn-edit-genre').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');

                    modalGenreAlert.classList.add('d-none');
                    modalGenreAlert.textContent = '';

                    modalGenreLabel.innerHTML = `<i class="bi bi-pencil-square text-warning me-2"></i>Sửa Thể Loại #${id}`;
                    btnSubmitGenreText.textContent = 'Lưu Thay Đổi';

                    modalGenreId.value = id;
                    modalGenreName.value = name;

                    genreModal.show();
                });
            });

            // 3. SUBMIT LƯU THỂ LOẠI (CREATE HOẶC UPDATE)
            btnSubmitGenre?.addEventListener('click', async function () {
                modalGenreAlert.classList.add('d-none');
                modalGenreAlert.textContent = '';

                const id = modalGenreId.value ? parseInt(modalGenreId.value, 10) : null;
                const name = modalGenreName.value.trim();

                if (!name) {
                    showError('Vui lòng nhập tên thể loại.');
                    return;
                }

                const isEdit = id && id > 0;
                const url = isEdit ? `/Admin/UpdateGenre?id=${id}` : '/Admin/CreateGenre';

                const origHtml = btnSubmitGenre.innerHTML;
                btnSubmitGenre.disabled = true;
                btnSubmitGenre.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...';

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name: name })
                    });

                    const data = await response.json();

                    if (response.ok) {
                        alert(data.message || (isEdit ? 'Cập nhật thể loại thành công!' : 'Tạo thể loại mới thành công!'));
                        window.location.reload();
                    } else {
                        showError(data.message || 'Không thể lưu thể loại.');
                        btnSubmitGenre.disabled = false;
                        btnSubmitGenre.innerHTML = origHtml;
                    }
                } catch (err) {
                    console.error('Lỗi khi lưu thể loại:', err);
                    showError('Lỗi kết nối tới máy chủ khi lưu thể loại.');
                    btnSubmitGenre.disabled = false;
                    btnSubmitGenre.innerHTML = origHtml;
                }
            });

            function showError(msg) {
                modalGenreAlert.textContent = msg;
                modalGenreAlert.classList.remove('d-none');
            }

            // 4. XÓA THỂ LOẠI (DELETE)
            document.querySelectorAll('.btn-delete-genre').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');
                    const count = parseInt(this.getAttribute('data-count') || '0', 10);

                    if (count > 0) {
                        alert(`Không thể xóa thể loại "${name}" vì đang có ${count} bộ phim thuộc thể loại này! Vui lòng gỡ thể loại khỏi các phim trước.`);
                        return;
                    }

                    if (!confirm(`Bạn có chắc chắn muốn xóa thể loại "${name}"?`)) return;

                    const origHtml = this.innerHTML;
                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                    try {
                        const response = await fetch(`/Admin/DeleteGenre?id=${id}`, {
                            method: 'POST'
                        });

                        const data = await response.json();

                        if (response.ok) {
                            alert(data.message || 'Xóa thể loại thành công!');
                            window.location.reload();
                        } else {
                            alert(data.message || 'Không thể xóa thể loại này.');
                            this.disabled = false;
                            this.innerHTML = origHtml;
                        }
                    } catch (err) {
                        console.error('Lỗi khi xóa thể loại:', err);
                        alert('Đã xảy ra lỗi kết nối tới máy chủ.');
                        this.disabled = false;
                        this.innerHTML = origHtml;
                    }
                });
            });
        });
    </script>
}
