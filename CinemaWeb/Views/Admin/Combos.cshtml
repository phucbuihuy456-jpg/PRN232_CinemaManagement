@{
    ViewData["Title"] = "Quản lý Combo Bắp Nước";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1"><i class="bi bi-cup-straw text-warning me-2"></i>Quản Lý Combo Bắp Nước</h3>
        <p class="text-secondary mb-0">Các gói combo bắp nước phục vụ khách xem phim (Quyền: Admin)</p>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-stars me-2"></i>Danh Sách Combo</span>
        <span class="badge bg-warning text-dark">Quyền: Admin</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="p-3 bg-dark border border-secondary rounded-3 text-center">
                    <img src="https://images.unsplash.com/photo-1585647347483-22b66260dfff?w=500" class="img-fluid rounded mb-2" style="height: 120px; object-fit: cover;" />
                    <h6 class="text-white fw-bold mb-1">Combo Solo</h6>
                    <div class="text-danger fw-bold">79,000 VNĐ</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-dark border border-secondary rounded-3 text-center">
                    <img src="https://images.unsplash.com/photo-1572177191856-3cde618dee1f?w=500" class="img-fluid rounded mb-2" style="height: 120px; object-fit: cover;" />
                    <h6 class="text-white fw-bold mb-1">Combo Couple</h6>
                    <div class="text-danger fw-bold">109,000 VNĐ</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-dark border border-secondary rounded-3 text-center">
                    <img src="https://images.unsplash.com/photo-1505686994434-e3cc5abf1330?w=500" class="img-fluid rounded mb-2" style="height: 120px; object-fit: cover;" />
                    <h6 class="text-white fw-bold mb-1">Combo Family</h6>
                    <div class="text-danger fw-bold">189,000 VNĐ</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-dark border border-secondary rounded-3 text-center">
                    <img src="https://images.unsplash.com/photo-1512149673953-1e251807ec7c?w=500" class="img-fluid rounded mb-2" style="height: 120px; object-fit: cover;" />
                    <h6 class="text-white fw-bold mb-1">Combo VIP</h6>
                    <div class="text-danger fw-bold">139,000 VNĐ</div>
                </div>
            </div>
        </div>
    </div>
</div>
