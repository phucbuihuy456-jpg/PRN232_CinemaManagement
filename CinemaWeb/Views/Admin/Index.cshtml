@{
    ViewData["Title"] = "Bảng điều khiển (Dashboard)";
    Layout = "_AdminLayout";
}

<!-- Welcome Banner -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card admin-card border-0 p-4" style="background: linear-gradient(135deg, #1f242e 0%, #15181f 100%);">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill mb-2">
                        <i class="bi bi-shield-check me-1"></i> Khu Vực Quản Trị Hệ Thống
                    </span>
                    <h2 class="fw-bold text-white mb-1">Xin chào, @User.Identity?.Name!</h2>
                    <p class="text-secondary mb-0">
                        Vai trò hiện tại: <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : "bg-warning text-dark") fs-6">@(User.IsInRole("Admin") ? "Quản Trị Viên (Admin)" : "Nhân Viên (Staff)")</span>
                        - Chúc bạn một ngày làm việc hiệu quả.
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Booking" asp-action="SeatMap" target="_blank" class="btn btn-outline-danger d-flex align-items-center">
                        <i class="bi bi-grid-3x3-gap me-2"></i> Mở Sơ đồ ghế (POS)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Statistics Cards -->
<div class="row g-3 mb-4">
    <!-- Phim đang chiếu -->
    <div class="col-sm-6 col-xl-3">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-bold">Phim đang chiếu</span>
                    <h3 class="fw-bold text-white mb-0 mt-1">3</h3>
                    <small class="text-success"><i class="bi bi-arrow-up"></i> Sẵn sàng phục vụ</small>
                </div>
                <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 fs-3">
                    <i class="bi bi-camera-reels"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Suất chiếu hôm nay -->
    <div class="col-sm-6 col-xl-3">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-bold">Suất chiếu hôm nay</span>
                    <h3 class="fw-bold text-white mb-0 mt-1">3</h3>
                    <small class="text-secondary">Phòng 01 & Phòng IMAX</small>
                </div>
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-3">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Combo bắp nước -->
    <div class="col-sm-6 col-xl-3">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-bold">Combo bắp nước</span>
                    <h3 class="fw-bold text-white mb-0 mt-1">4</h3>
                    <small class="text-success"><i class="bi bi-check-circle"></i> Đang bán</small>
                </div>
                <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3 fs-3">
                    <i class="bi bi-cup-straw"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tình trạng hệ thống -->
    <div class="col-sm-6 col-xl-3">
        <div class="card admin-card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-bold">Dịch vụ ngầm</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">Active</h3>
                    <small class="text-secondary">Quét giải phóng ghế (30s)</small>
                </div>
                <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-3">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Function Shortcuts -->
<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-grid me-2 text-danger"></i>Lối Tắt Chức Năng Quản Trị</span>
        <span class="badge bg-secondary">Phân quyền theo Role</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @if (User.IsInRole("Admin"))
            {
                <div class="col-md-4">
                    <a asp-action="Movies" class="card bg-dark border border-secondary text-decoration-none p-3 h-100 d-flex flex-row align-items-center hover-card">
                        <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle me-3 fs-4">
                            <i class="bi bi-film"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-white">Quản lý Phim</div>
                            <small class="text-secondary">CRUD phim, thể loại, poster, thời lượng</small>
                        </div>
                    </a>
                </div>
            }

            <div class="col-md-4">
                <a asp-action="Showtimes" class="card bg-dark border border-secondary text-decoration-none p-3 h-100 d-flex flex-row align-items-center hover-card">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3 fs-4">
                        <i class="bi bi-calendar2-week"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white">Suất Chiếu</div>
                        <small class="text-secondary">Lịch chiếu, phân bổ phòng chiếu</small>
                    </div>
                </a>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="col-md-4">
                    <a asp-action="Combos" class="card bg-dark border border-secondary text-decoration-none p-3 h-100 d-flex flex-row align-items-center hover-card">
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle me-3 fs-4">
                            <i class="bi bi-cup-straw"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-white">Combo Bắp Nước</div>
                            <small class="text-secondary">Quản lý các gói combo và giá bán</small>
                        </div>
                    </a>
                </div>
            }
            else
            {
                <div class="col-md-4">
                    <a asp-controller="Booking" asp-action="SeatMap" target="_blank" class="card bg-dark border border-secondary text-decoration-none p-3 h-100 d-flex flex-row align-items-center hover-card">
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle me-3 fs-4">
                            <i class="bi bi-grid-3x3-gap"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-white">Bán Vé Tại Quầy (POS)</div>
                            <small class="text-secondary">Chọn ghế và đặt combo cho khách hàng</small>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
