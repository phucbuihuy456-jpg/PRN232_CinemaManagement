@model CinemaWeb.Models.PosViewModel
@{
    ViewData["Title"] = "Staff POS Bán vé tại quầy";
    Layout = "_Layout";
}

<div class="container-fluid px-4 py-3">
    <!-- Top Bar POS -->
    <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-dark rounded border border-secondary shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-danger fs-5 px-3 py-2 fw-bold">
                <i class="bi bi-display me-2"></i>STAFF POS CONSOLE
            </span>
            <span class="text-light fw-semibold">
                <i class="bi bi-person-badge-fill text-warning me-1"></i> Nhân viên: <strong>Thu ngân Quầy 01</strong>
            </span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span id="posLiveClock" class="badge bg-black border border-secondary text-info fs-6 px-3 py-2 font-monospace">
                --:--:--
            </span>
            <a href="/" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-arrow-right me-1"></i> Thoát POS
            </a>
        </div>
    </div>

    <div class="row g-3">
        <!-- LEFT 8 COLS: Showtime Selector, Seat Map, and Combos -->
        <div class="col-lg-8">
            <!-- 1. CHỌN SUẤT CHIẾU NHANH (Task 31) -->
            <div class="card bg-dark border-secondary mb-3 shadow">
                <div class="card-header bg-black border-secondary py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-white small">
                        <i class="bi bi-calendar2-range-fill text-danger me-1"></i> 1. CHỌN SUẤT CHIẾU
                    </span>
                    <span class="badge bg-secondary small">Hôm nay (@DateTime.Today.ToString("dd/MM/yyyy"))</span>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2">
                        @foreach (var st in Model.Showtimes)
                        {
                            <div class="col-md-4 col-sm-6">
                                <button type="button"
                                        class="btn btn-outline-light w-100 text-start p-2 pos-showtime-btn"
                                        data-showtime-id="@st.Id"
                                        data-movie-title="@st.MovieTitle"
                                        data-room-name="@st.RoomName"
                                        data-screen-type="@st.ScreenType"
                                        data-time="@st.StartTime.ToString("HH:mm")"
                                        data-base-price="@st.BasePrice">
                                    <div class="fw-bold text-truncate text-warning mb-1">
                                        <i class="bi bi-film me-1"></i>@st.MovieTitle
                                    </div>
                                    <div class="d-flex justify-content-between text-secondary small" style="font-size: 0.8rem;">
                                        <span class="text-white"><i class="bi bi-clock me-1"></i><strong>@st.StartTime.ToString("HH:mm")</strong></span>
                                        <span>@st.RoomName (@st.ScreenType)</span>
                                    </div>
                                    <div class="d-flex justify-content-between small text-secondary mt-1" style="font-size: 0.75rem;">
                                        <span>Giá gốc: @st.BasePrice.ToString("N0") đ</span>
                                        <span class="text-success fw-bold">Trống @st.AvailableSeats/@st.TotalSeats</span>
                                    </div>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. SƠ ĐỒ GHẾ TRỰC TIẾP (Task 31) -->
            <div class="card bg-dark border-secondary mb-3 shadow">
                <div class="card-header bg-black border-secondary py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-white small">
                        <i class="bi bi-grid-3x3 text-danger me-1"></i> 2. CHỌN GHẾ CHO KHÁCH
                    </span>
                    <span id="posCurrentShowtimeTitle" class="badge bg-warning text-dark small fw-bold">
                        Vui lòng chọn 1 suất chiếu ở trên
                    </span>
                </div>
                <div class="card-body p-3 text-center">
                    <!-- Screen visual -->
                    <div class="screen-container mb-3" style="max-width: 500px; margin: 0 auto;">
                        <div class="cinema-screen" style="height: 6px;"></div>
                        <div class="screen-text small" style="font-size: 0.75rem;">MÀN HÌNH CHIẾU / SCREEN</div>
                    </div>

                    <!-- Dynamic Seat Grid Container -->
                    <div id="posSeatGrid" class="pos-seat-grid-wrapper mb-3" style="min-height: 200px; overflow-x: auto;">
                        <div class="text-secondary py-5 fst-italic">
                            <i class="bi bi-hand-index-thumb fs-2 d-block mb-2"></i>
                            Nhấp chọn một suất chiếu phía trên để tải sơ đồ ghế
                        </div>
                    </div>

                    <!-- Mini Legend -->
                    <div class="d-flex justify-content-center gap-3 flex-wrap small text-secondary pt-2 border-top border-secondary border-opacity-50">
                        <span><span class="d-inline-block rounded me-1" style="width:12px; height:12px; background:#475569;"></span> Thường</span>
                        <span><span class="d-inline-block rounded me-1" style="width:12px; height:12px; background:#f59e0b;"></span> VIP</span>
                        <span><span class="d-inline-block rounded me-1" style="width:12px; height:12px; background:#ec4899;"></span> Couple</span>
                        <span><span class="d-inline-block rounded me-1" style="width:12px; height:12px; background:#10b981;"></span> Đang chọn</span>
                        <span><span class="d-inline-block rounded me-1" style="width:12px; height:12px; background:#ef4444;"></span> Đã bán</span>
                    </div>
                </div>
            </div>

            <!-- 3. CHỌN COMBO BẮP NƯỚC NHANH (Task 31) -->
            <div class="card bg-dark border-secondary shadow">
                <div class="card-header bg-black border-secondary py-2">
                    <span class="fw-bold text-white small">
                        <i class="bi bi-cup-straw text-danger me-1"></i> 3. CHỌN COMBO BẮP & NƯỚC (F&B)
                    </span>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2">
                        @foreach (var combo in Model.Combos)
                        {
                            <div class="col-md-4 col-sm-6">
                                <div class="p-2 rounded border border-secondary bg-black bg-opacity-50 d-flex justify-content-between align-items-center">
                                    <div class="text-truncate me-2">
                                        <div class="fw-semibold text-light small text-truncate">@combo.Name</div>
                                        <div class="text-warning small fw-bold">@combo.Price.ToString("N0") đ</div>
                                    </div>
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm btn-pos-add-combo px-3"
                                            data-combo-id="@combo.Id"
                                            data-combo-name="@combo.Name"
                                            data-combo-price="@combo.Price">
                                        <i class="bi bi-plus-lg"></i> Thêm
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT 4 COLS: Order Summary & Cash Register -->
        <div class="col-lg-4">
            <div class="card bg-dark border-secondary shadow sticky-top" style="top: 15px;">
                <div class="card-header bg-black border-secondary py-2 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-white mb-0">
                        <i class="bi bi-receipt-cutoff text-danger me-2"></i>HÓA ĐƠN BÁN VÉ POS
                    </h6>
                    <button type="button" id="btnResetPosOrder" class="btn btn-outline-secondary btn-sm py-0 px-2 small">
                        <i class="bi bi-arrow-counterclockwise"></i> Làm mới
                    </button>
                </div>
                <div class="card-body p-3">
                    <!-- Showtime Selected Info -->
                    <div class="p-2 rounded bg-black border border-secondary mb-3 small">
                        <div class="text-secondary">Suất chiếu:</div>
                        <div id="posSummaryMovie" class="text-white fw-bold">Chưa chọn suất chiếu</div>
                        <div id="posSummaryTimeRoom" class="text-warning small">--</div>
                    </div>

                    <!-- Selected Seats List -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between text-secondary small fw-semibold mb-1">
                            <span>GHẾ ĐÃ CHỌN (<span id="posSeatsCount">0</span>):</span>
                            <span>GIÁ VÉ</span>
                        </div>
                        <div id="posSeatsContainer" class="d-flex flex-column gap-1" style="max-height: 120px; overflow-y: auto;">
                            <div class="text-secondary small fst-italic">Chưa chọn ghế nào</div>
                        </div>
                    </div>

                    <!-- Selected Combos List -->
                    <div class="mb-3 pt-2 border-top border-secondary">
                        <div class="d-flex justify-content-between text-secondary small fw-semibold mb-1">
                            <span>BẮP NƯỚC:</span>
                            <span>THÀNH TIỀN</span>
                        </div>
                        <div id="posCombosContainer" class="d-flex flex-column gap-1" style="max-height: 100px; overflow-y: auto;">
                            <div class="text-secondary small fst-italic">Chưa chọn combo nào</div>
                        </div>
                    </div>

                    <!-- Customer Info (Optional) -->
                    <div class="mb-3 pt-2 border-top border-secondary">
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="text" id="posCustName" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="Tên khách (tùy chọn)" />
                            </div>
                            <div class="col-6">
                                <input type="tel" id="posCustPhone" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="SĐT khách" />
                            </div>
                        </div>
                    </div>

                    <!-- TOTAL AMOUNT TO COLLECT -->
                    <div class="p-3 rounded bg-black border border-secondary mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-uppercase fw-bold text-secondary small">TỔNG PHẢI THU:</span>
                            <span id="posTotalAmount" class="text-warning fs-3 fw-bold font-monospace">0 đ</span>
                        </div>
                    </div>

                    <!-- CASH PAYMENT SECTION (Task 31) -->
                    <div class="p-3 rounded bg-black border border-danger mb-3">
                        <div class="fw-bold text-white small mb-2">
                            <i class="bi bi-cash-stack text-success me-1"></i> THU TIỀN MẶT (CASH):
                        </div>
                        
                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text bg-dark text-secondary border-secondary">Khách đưa:</span>
                            <input type="number" id="posCashReceived" class="form-control bg-dark text-white border-secondary fw-bold text-end fs-6" placeholder="0" />
                            <span class="input-group-text bg-dark text-secondary border-secondary">đ</span>
                        </div>

                        <!-- Quick Cash Shortcuts -->
                        <div class="d-flex gap-1 mb-2 flex-wrap">
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 small btn-quick-cash" data-amount="exact">Đủ tiền</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 small btn-quick-cash" data-amount="100000">100k</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 small btn-quick-cash" data-amount="200000">200k</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 small btn-quick-cash" data-amount="500000">500k</button>
                        </div>

                        <!-- Change Due (Tiền thừa thối lại) -->
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary">
                            <span class="text-secondary small fw-bold">TIỀN THỐI LẠI:</span>
                            <span id="posChangeAmount" class="text-success fs-5 fw-bold font-monospace">0 đ</span>
                        </div>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <button type="button" id="btnPosSubmitCheckout" class="btn btn-danger btn-lg w-100 fw-bold py-3 shadow" disabled>
                        <i class="bi bi-printer-fill me-2"></i> THANH TOÁN & IN VÉ (CASH)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL POS IN VÉ & XUẤT QR (Task 31) -->
<div class="modal fade" id="posReceiptModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary shadow-lg">
            <div class="modal-header bg-black border-secondary">
                <h5 class="modal-title fw-bold text-success">
                    <i class="bi bi-check-circle-fill me-2"></i>ĐẶT VÉ POS THÀNH CÔNG!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="posReceiptPrintArea">
                <!-- Thermal Receipt Layout -->
                <div class="bg-white text-dark p-4 rounded shadow-sm font-monospace" style="font-size: 0.9rem;">
                    <div class="text-center mb-3 border-bottom pb-2">
                        <h4 class="fw-bold mb-0">CINEMA SYSTEM</h4>
                        <div class="small text-muted">VÉ XEM PHIM & HÓA ĐƠN BÁN LẺ</div>
                        <div class="small fw-bold mt-1">Đơn hàng: <span id="receiptBookingId">#--</span></div>
                        <div class="small text-muted" id="receiptTime">--</div>
                    </div>

                    <!-- Movie info -->
                    <div class="mb-2">
                        <div class="fw-bold fs-6 text-uppercase" id="receiptMovieTitle">--</div>
                        <div class="small">Phòng: <strong id="receiptRoomName">--</strong> | <span id="receiptShowTime">--</span></div>
                    </div>

                    <!-- Seats list -->
                    <div class="mb-2 border-top pt-2">
                        <div class="fw-bold small mb-1">DANH SÁCH GHẾ:</div>
                        <div id="receiptSeatsList" class="d-flex flex-column gap-1 small">--</div>
                    </div>

                    <!-- Combos list -->
                    <div id="receiptCombosSection" class="mb-2 border-top pt-2 d-none">
                        <div class="fw-bold small mb-1">BẮP & NƯỚC:</div>
                        <div id="receiptCombosList" class="d-flex flex-column gap-1 small">--</div>
                    </div>

                    <!-- Payment summary -->
                    <div class="border-top border-bottom py-2 my-2">
                        <div class="d-flex justify-content-between fw-bold fs-6">
                            <span>TỔNG TIỀN:</span>
                            <span id="receiptTotalAmount">--</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Tiền khách đưa:</span>
                            <span id="receiptCashReceived">--</span>
                        </div>
                        <div class="d-flex justify-content-between small text-success fw-bold">
                            <span>Tiền thối:</span>
                            <span id="receiptChangeAmount">0 đ</span>
                        </div>
                    </div>

                    <!-- QR Code -->
                    <div class="text-center my-3">
                        <img id="receiptQrImage" src="" alt="QR Token" style="width: 140px; height: 140px;" class="border p-1 rounded" />
                        <div class="small text-muted mt-1 font-monospace" id="receiptQrToken">--</div>
                        <div class="small text-muted fst-italic">Quét mã QR tại cửa soát vé để vào phòng</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-black border-secondary">
                <button type="button" class="btn btn-outline-light" onclick="printReceiptArea()">
                    <i class="bi bi-printer me-1"></i> In hóa đơn / vé
                </button>
                <button type="button" class="btn btn-success fw-bold px-4" data-bs-dismiss="modal" id="btnNextPosOrder">
                    <i class="bi bi-plus-circle me-1"></i> Đơn tiếp theo
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Live Clock
            const clockEl = document.getElementById('posLiveClock');
            function updateClock() {
                const now = new Date();
                clockEl.textContent = now.toLocaleTimeString('vi-VN');
            }
            updateClock();
            setInterval(updateClock, 1000);

            // 2. POS State
            let currentShowtimeId = null;
            let currentShowtimeData = null;
            const selectedSeats = new Map(); // seatId -> { name, price, type }
            const selectedCombos = new Map(); // comboId -> { name, price, qty }

            const posSeatGrid = document.getElementById('posSeatGrid');
            const posCurrentShowtimeTitle = document.getElementById('posCurrentShowtimeTitle');
            const posSummaryMovie = document.getElementById('posSummaryMovie');
            const posSummaryTimeRoom = document.getElementById('posSummaryTimeRoom');
            const posSeatsContainer = document.getElementById('posSeatsContainer');
            const posSeatsCount = document.getElementById('posSeatsCount');
            const posCombosContainer = document.getElementById('posCombosContainer');
            const posTotalAmount = document.getElementById('posTotalAmount');
            const posCashReceived = document.getElementById('posCashReceived');
            const posChangeAmount = document.getElementById('posChangeAmount');
            const btnPosSubmitCheckout = document.getElementById('btnPosSubmitCheckout');

            // 3. Xử lý chọn suất chiếu
            document.querySelectorAll('.pos-showtime-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.pos-showtime-btn').forEach(b => b.classList.remove('active', 'btn-warning', 'text-dark'));
                    this.classList.add('active', 'btn-warning', 'text-dark');

                    currentShowtimeId = parseInt(this.getAttribute('data-showtime-id'), 10);
                    currentShowtimeData = {
                        id: currentShowtimeId,
                        title: this.getAttribute('data-movie-title'),
                        room: this.getAttribute('data-room-name'),
                        screen: this.getAttribute('data-screen-type'),
                        time: this.getAttribute('data-time'),
                        basePrice: parseFloat(this.getAttribute('data-base-price') || '0')
                    };

                    posCurrentShowtimeTitle.textContent = `${currentShowtimeData.title} | ${currentShowtimeData.time} (${currentShowtimeData.room})`;
                    posSummaryMovie.textContent = currentShowtimeData.title;
                    posSummaryTimeRoom.textContent = `${currentShowtimeData.time} - ${currentShowtimeData.room} (${currentShowtimeData.screen})`;

                    // Xóa danh sách ghế đang chọn khi đổi suất chiếu
                    selectedSeats.clear();
                    updateOrderSummary();
                    loadSeatMap(currentShowtimeId);
                });
            });

            // 4. Tải sơ đồ ghế AJAX
            async function loadSeatMap(showtimeId) {
                posSeatGrid.innerHTML = '<div class="py-5 text-secondary"><span class="spinner-border spinner-border-sm me-2"></span> Đang tải sơ đồ ghế...</div>';
                try {
                    const res = await fetch(`/Pos/GetSeatMap/${showtimeId}`);
                    if (!res.ok) throw new Error('Không thể tải sơ đồ ghế');
                    const data = await res.json();
                    renderSeatMap(data);
                } catch (e) {
                    posSeatGrid.innerHTML = `<div class="py-5 text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Lỗi tải sơ đồ ghế: ${e.message}</div>`;
                }
            }

            function renderSeatMap(data) {
                if (!data || !data.seats) return;

                // Nhóm theo hàng ghế
                const rows = {};
                data.seats.forEach(s => {
                    if (!rows[s.rowCode]) rows[s.rowCode] = [];
                    rows[s.rowCode].push(s);
                });

                let html = '<div class="d-flex flex-column align-items-center gap-2">';

                Object.keys(rows).sort().forEach(rowKey => {
                    html += '<div class="d-flex align-items-center gap-1">';
                    html += `<span class="badge bg-secondary me-2" style="width:24px;">${rowKey}</span>`;

                    rows[rowKey].sort((a, b) => a.seatNumber - b.seatNumber).forEach(seat => {
                        let btnClass = 'btn-secondary';
                        let isSold = seat.status === 'Sold';
                        let isHeld = seat.status === 'Held';
                        let isDisabled = seat.status === 'Disabled' || isSold || isHeld;

                        if (seat.seatTypeName === 'VIP') btnClass = 'btn-warning text-dark';
                        else if (seat.seatTypeName === 'Couple') btnClass = 'btn-danger';

                        if (isSold) btnClass = 'btn-dark text-secondary border-0';
                        else if (isHeld) btnClass = 'btn-outline-warning';

                        const isSelected = selectedSeats.has(seat.seatId);
                        if (isSelected) btnClass = 'btn-success text-white shadow';

                        html += `
                            <button type="button"
                                    class="btn btn-sm pos-seat-btn ${btnClass}"
                                    data-seat-id="${seat.seatId}"
                                    data-seat-name="${seat.seatName}"
                                    data-price="${seat.finalPrice}"
                                    data-type="${seat.seatTypeName}"
                                    data-status="${seat.status}"
                                    ${isDisabled ? 'disabled' : ''}
                                    style="width: 38px; height: 34px; font-size: 0.75rem; padding: 0;">
                                ${isSold ? '<i class="bi bi-x-lg"></i>' : seat.seatName}
                            </button>
                        `;
                    });

                    html += `<span class="badge bg-secondary ms-2" style="width:24px;">${rowKey}</span>`;
                    html += '</div>';
                });

                html += '</div>';
                posSeatGrid.innerHTML = html;

                // Gắn sự kiện click ghế
                posSeatGrid.querySelectorAll('.pos-seat-btn').forEach(btn => {
                    btn.addEventListener('click', function () {
                        const status = this.getAttribute('data-status');
                        if (status !== 'Available') return;

                        const seatId = parseInt(this.getAttribute('data-seat-id'), 10);
                        const seatName = this.getAttribute('data-seat-name');
                        const price = parseFloat(this.getAttribute('data-price') || '0');
                        const type = this.getAttribute('data-type');

                        if (selectedSeats.has(seatId)) {
                            selectedSeats.delete(seatId);
                            this.classList.remove('btn-success', 'text-white', 'shadow');
                            if (type === 'VIP') this.classList.add('btn-warning', 'text-dark');
                            else if (type === 'Couple') this.classList.add('btn-danger');
                            else this.classList.add('btn-secondary');
                        } else {
                            if (selectedSeats.size >= 8) {
                                alert('Mỗi đơn bán vé POS chỉ được chọn tối đa 8 ghế.');
                                return;
                            }
                            selectedSeats.set(seatId, { name: seatName, price: price, type: type });
                            this.className = 'btn btn-sm pos-seat-btn btn-success text-white shadow';
                        }

                        updateOrderSummary();
                    });
                });
            }

            // 5. Thêm Combo vào đơn POS
            document.querySelectorAll('.btn-pos-add-combo').forEach(btn => {
                btn.addEventListener('click', function () {
                    const comboId = parseInt(this.getAttribute('data-combo-id'), 10);
                    const name = this.getAttribute('data-combo-name');
                    const price = parseFloat(this.getAttribute('data-combo-price') || '0');

                    if (selectedCombos.has(comboId)) {
                        const item = selectedCombos.get(comboId);
                        item.qty++;
                    } else {
                        selectedCombos.set(comboId, { id: comboId, name: name, price: price, qty: 1 });
                    }

                    updateOrderSummary();
                });
            });

            // 6. Cập nhật hóa đơn tóm tắt
            function updateOrderSummary() {
                // Ghế
                posSeatsContainer.innerHTML = '';
                let seatTotal = 0;
                if (selectedSeats.size === 0) {
                    posSeatsContainer.innerHTML = '<div class="text-secondary small fst-italic">Chưa chọn ghế nào</div>';
                } else {
                    selectedSeats.forEach((seat, id) => {
                        seatTotal += seat.price;
                        const row = document.createElement('div');
                        row.className = 'd-flex justify-content-between align-items-center small';
                        row.innerHTML = `
                            <span class="text-light">
                                <i class="bi bi-ticket text-danger me-1"></i>Ghế <strong>${seat.name}</strong> (${seat.type})
                            </span>
                            <div>
                                <span class="text-warning fw-bold me-2">${new Intl.NumberFormat('vi-VN').format(seat.price)} đ</span>
                                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1 btn-remove-seat" data-id="${id}">×</button>
                            </div>
                        `;
                        posSeatsContainer.appendChild(row);
                    });
                }
                posSeatsCount.textContent = selectedSeats.size;

                // Gắn nút xóa ghế
                posSeatsContainer.querySelectorAll('.btn-remove-seat').forEach(b => {
                    b.addEventListener('click', function () {
                        const id = parseInt(this.getAttribute('data-id'), 10);
                        selectedSeats.delete(id);
                        if (currentShowtimeId) loadSeatMap(currentShowtimeId);
                        updateOrderSummary();
                    });
                });

                // Combo
                posCombosContainer.innerHTML = '';
                let comboTotal = 0;
                if (selectedCombos.size === 0) {
                    posCombosContainer.innerHTML = '<div class="text-secondary small fst-italic">Chưa chọn combo nào</div>';
                } else {
                    selectedCombos.forEach((c, id) => {
                        const cTotal = c.price * c.qty;
                        comboTotal += cTotal;
                        const row = document.createElement('div');
                        row.className = 'd-flex justify-content-between align-items-center small';
                        row.innerHTML = `
                            <span class="text-light">
                                <i class="bi bi-cup text-warning me-1"></i>${c.name} x${c.qty}
                            </span>
                            <div>
                                <span class="text-warning fw-bold me-2">${new Intl.NumberFormat('vi-VN').format(cTotal)} đ</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 me-1 btn-minus-combo" data-id="${id}">-</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 btn-plus-combo" data-id="${id}">+</button>
                            </div>
                        `;
                        posCombosContainer.appendChild(row);
                    });
                }

                // Gắn nút tăng giảm combo
                posCombosContainer.querySelectorAll('.btn-plus-combo').forEach(b => {
                    b.addEventListener('click', function () {
                        const id = parseInt(this.getAttribute('data-id'), 10);
                        selectedCombos.get(id).qty++;
                        updateOrderSummary();
                    });
                });
                posCombosContainer.querySelectorAll('.btn-minus-combo').forEach(b => {
                    b.addEventListener('click', function () {
                        const id = parseInt(this.getAttribute('data-id'), 10);
                        const c = selectedCombos.get(id);
                        c.qty--;
                        if (c.qty <= 0) selectedCombos.delete(id);
                        updateOrderSummary();
                    });
                });

                // Tổng tiền
                const grandTotal = seatTotal + comboTotal;
                posTotalAmount.textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(grandTotal);

                // Kích hoạt nút thanh toán nếu có ghế
                btnPosSubmitCheckout.disabled = (selectedSeats.size === 0 || !currentShowtimeId);

                calculateChange(grandTotal);
            }

            // 7. Xử lý tính tiền thối lại (Cash Calculator)
            function calculateChange(grandTotal) {
                const received = parseFloat(posCashReceived.value || '0');
                if (received >= grandTotal && grandTotal > 0) {
                    const change = received - grandTotal;
                    posChangeAmount.textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(change);
                    posChangeAmount.className = 'text-success fs-5 fw-bold font-monospace';
                } else if (received > 0 && received < grandTotal) {
                    const missing = grandTotal - received;
                    posChangeAmount.textContent = `Thiếu ${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(missing)}`;
                    posChangeAmount.className = 'text-danger fs-6 fw-bold font-monospace';
                } else {
                    posChangeAmount.textContent = '0 đ';
                    posChangeAmount.className = 'text-secondary fs-5 fw-bold font-monospace';
                }
            }

            posCashReceived.addEventListener('input', () => {
                const total = parseCurrency(posTotalAmount.textContent);
                calculateChange(total);
            });

            document.querySelectorAll('.btn-quick-cash').forEach(b => {
                b.addEventListener('click', function () {
                    const type = this.getAttribute('data-amount');
                    const total = parseCurrency(posTotalAmount.textContent);
                    if (type === 'exact') {
                        posCashReceived.value = total;
                    } else {
                        posCashReceived.value = parseFloat(type);
                    }
                    calculateChange(total);
                });
            });

            function parseCurrency(str) {
                return parseFloat(str.replace(/[^\d]/g, '') || '0');
            }

            // 8. Xử lý Submit Thanh toán & Xuất vé (F9 hoặc click)
            btnPosSubmitCheckout.addEventListener('click', async function () {
                if (selectedSeats.size === 0 || !currentShowtimeId) return;

                const total = parseCurrency(posTotalAmount.textContent);
                let received = parseFloat(posCashReceived.value || '0');
                if (received < total) {
                    received = total; // Mặc định đủ tiền mặt nếu chưa nhập
                    posCashReceived.value = total;
                }

                const combosArray = [];
                selectedCombos.forEach(c => combosArray.push({ comboId: c.id, quantity: c.qty }));

                const payload = {
                    showtimeId: currentShowtimeId,
                    seatIds: Array.from(selectedSeats.keys()),
                    combos: combosArray,
                    paymentMethod: "Cash",
                    cashReceived: received,
                    customerName: document.getElementById('posCustName').value.trim() || "Khách tại quầy",
                    customerPhone: document.getElementById('posCustPhone').value.trim() || null
                };

                const originalBtnHtml = btnPosSubmitCheckout.innerHTML;
                btnPosSubmitCheckout.disabled = true;
                btnPosSubmitCheckout.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang tạo đơn vé & QR...';

                try {
                    const res = await fetch('/Pos/QuickCheckout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await res.json();

                    if (res.ok && data.success) {
                        // Hiển thị hóa đơn trên Modal
                        document.getElementById('receiptBookingId').textContent = `#${data.bookingId}`;
                        document.getElementById('receiptTime').textContent = new Date().toLocaleString('vi-VN');
                        document.getElementById('receiptMovieTitle').textContent = data.showtime.movieTitle;
                        document.getElementById('receiptRoomName').textContent = data.showtime.roomName;
                        document.getElementById('receiptShowTime').textContent = new Date(data.showtime.startTime).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

                        // Ghế
                        let seatsHtml = '';
                        data.seats.forEach(s => {
                            seatsHtml += `<div class="d-flex justify-content-between"><span>Ghế ${s.seatName} (${s.seatTypeName})</span><span>${new Intl.NumberFormat('vi-VN').format(s.price)} đ</span></div>`;
                        });
                        document.getElementById('receiptSeatsList').innerHTML = seatsHtml;

                        // Combo
                        if (data.combos && data.combos.length > 0) {
                            document.getElementById('receiptCombosSection').classList.remove('d-none');
                            let combosHtml = '';
                            data.combos.forEach(c => {
                                combosHtml += `<div class="d-flex justify-content-between"><span>${c.comboName} x${c.quantity}</span><span>${new Intl.NumberFormat('vi-VN').format(c.totalPrice)} đ</span></div>`;
                            });
                            document.getElementById('receiptCombosList').innerHTML = combosHtml;
                        } else {
                            document.getElementById('receiptCombosSection').classList.add('d-none');
                        }

                        // Tiền
                        document.getElementById('receiptTotalAmount').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(data.totalAmount);
                        document.getElementById('receiptCashReceived').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(data.cashReceived);
                        document.getElementById('receiptChangeAmount').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(data.changeAmount);

                        // QR Image
                        document.getElementById('receiptQrImage').src = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${data.qrCodeToken}`;
                        document.getElementById('receiptQrToken').textContent = data.qrCodeToken;

                        const modal = new bootstrap.Modal(document.getElementById('posReceiptModal'));
                        modal.show();
                    } else {
                        alert(data.message || 'Lỗi thanh toán tại quầy!');
                    }
                } catch (err) {
                    console.error('POS Checkout error:', err);
                    alert('Lỗi kết nối máy chủ khi bán vé POS!');
                } finally {
                    btnPosSubmitCheckout.disabled = false;
                    btnPosSubmitCheckout.innerHTML = originalBtnHtml;
                }
            });

            // 9. Nút tạo đơn tiếp theo
            document.getElementById('btnNextPosOrder').addEventListener('click', function () {
                selectedSeats.clear();
                selectedCombos.clear();
                posCashReceived.value = '';
                document.getElementById('posCustName').value = '';
                document.getElementById('posCustPhone').value = '';
                if (currentShowtimeId) loadSeatMap(currentShowtimeId);
                updateOrderSummary();
            });

            document.getElementById('btnResetPosOrder').addEventListener('click', function () {
                if (confirm('Làm mới toàn bộ đơn hàng hiện tại?')) {
                    selectedSeats.clear();
                    selectedCombos.clear();
                    posCashReceived.value = '';
                    if (currentShowtimeId) loadSeatMap(currentShowtimeId);
                    updateOrderSummary();
                }
            });
        });

        function printReceiptArea() {
            const printContent = document.getElementById('posReceiptPrintArea').innerHTML;
            const originalContent = document.body.innerHTML;
            document.body.innerHTML = printContent;
            window.print();
            document.body.innerHTML = originalContent;
            window.location.reload();
        }
    </script>
}
