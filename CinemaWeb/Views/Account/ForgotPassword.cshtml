@model CinemaWeb.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên Mật Khẩu - Nhận Mã OTP";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-black border border-secondary shadow-lg rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <h2 class="text-danger fw-bold"><i class="bi bi-film me-2"></i>CINEMA</h2>
                    </a>
                    <div class="my-3">
                        <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger fs-2">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                    </div>
                    <h4 class="text-light fw-bold mt-1">Quên Mật Khẩu?</h4>
                    <p class="text-secondary small">
                        Nhập địa chỉ email liên kết với tài khoản của bạn. Chúng tôi sẽ gửi mã OTP gồm 6 chữ số để bạn đặt lại mật khẩu.
                    </p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                {
                    <div class="alert alert-danger d-flex align-items-center small py-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger m-0 list-unstyled" })
                        </div>
                    </div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                    <!-- Email Input -->
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label text-light small fw-semibold">Email tài khoản</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control bg-dark text-light border-secondary py-2" placeholder="name@example.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-danger w-100 py-2 fw-bold rounded-pill shadow mb-3">
                        <i class="bi bi-send-fill me-2"></i>Gửi Mã Xác Thực OTP
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top border-secondary">
                    <a asp-controller="Account" asp-action="Login" class="text-secondary text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
