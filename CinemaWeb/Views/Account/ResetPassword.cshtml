@model CinemaWeb.Models.ResetPasswordOtpViewModel
@{
    ViewData["Title"] = "Xác Thực OTP & Đặt Lại Mật Khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-black border border-secondary shadow-lg rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <h2 class="text-danger fw-bold"><i class="bi bi-film me-2"></i>CINEMA</h2>
                    </a>
                    <div class="my-3">
                        <div class="d-inline-flex p-3 rounded-circle bg-warning bg-opacity-10 text-warning fs-2">
                            <i class="bi bi-key-fill"></i>
                        </div>
                    </div>
                    <h4 class="text-light fw-bold mt-1">Xác Thực & Đặt Mật Khẩu</h4>
                    <p class="text-secondary small">
                        Mã OTP 6 số đã được gửi tới: <br />
                        <strong class="text-danger">@Model.Email</strong>
                    </p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success d-flex align-items-center small py-2 mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger d-flex align-items-center small py-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                {
                    <div class="alert alert-danger d-flex align-items-center small py-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger m-0 list-unstyled" })
                        </div>
                    </div>
                }

                <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                    <input type="hidden" asp-for="Email" />

                    <!-- OTP Input -->
                    <div class="mb-3">
                        <label asp-for="Otp" class="form-label text-light small fw-semibold">Mã xác thực OTP (6 chữ số)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-warning">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <input asp-for="Otp" 
                                   class="form-control bg-dark text-warning border-secondary text-center fw-bold fs-4 py-2" 
                                   placeholder="------" 
                                   maxlength="6" 
                                   style="letter-spacing: 6px;"
                                   autocomplete="one-time-code" 
                                   autofocus />
                        </div>
                        <span asp-validation-for="Otp" class="text-danger small mt-1 d-block"></span>
                        <span class="text-secondary small d-block mt-1">⏱️ Mã có hiệu lực trong 5 phút.</span>
                    </div>

                    <!-- New Password Input -->
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label text-light small fw-semibold">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="NewPassword" type="password" class="form-control bg-dark text-light border-secondary" placeholder="Tối thiểu 6 ký tự" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Confirm Password Input -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label text-light small fw-semibold">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control bg-dark text-light border-secondary" placeholder="Nhập lại mật khẩu mới" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-danger w-100 py-2 fw-bold rounded-pill shadow mb-3">
                        <i class="bi bi-check2-circle me-2"></i>Xác Nhận & Đổi Mật Khẩu
                    </button>
                </form>

                <!-- Nút gửi lại mã OTP -->
                <div class="text-center pt-3 border-top border-secondary">
                    <p class="text-secondary small mb-2">Chưa nhận được mã hoặc mã đã hết hạn?</p>
                    <form asp-controller="Account" asp-action="ResendOtp" method="post" class="d-inline">
                        <input type="hidden" name="email" value="@Model.Email" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="bi bi-arrow-clockwise me-1"></i> Gửi lại mã OTP
                        </button>
                    </form>
                </div>

                <div class="text-center mt-3">
                    <a asp-controller="Account" asp-action="Login" class="text-secondary text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
