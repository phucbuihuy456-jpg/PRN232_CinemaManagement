<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Hệ Thống Rạp Chiếu Phim</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Seat Map CSS -->
    <link rel="stylesheet" href="~/css/seat-map.css" asp-append-version="true" />
    <!-- Custom Customer CSS -->
    <link rel="stylesheet" href="~/css/customer-home.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light d-flex flex-column min-vh-100">
    <!-- Header / Navbar Customer -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark cinema-navbar border-bottom border-dark py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-danger fs-3 d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-film me-2"></i>CINEMA
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCustomer">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCustomer">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#movies-section">
                                <i class="bi bi-camera-reels me-1"></i> Phim Chiếu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="SeatMap">
                                <i class="bi bi-grid-3x3-gap me-1"></i> Đặt Vé Nhanh
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <a href="http://localhost:5027/swagger" target="_blank" class="btn btn-sm btn-outline-secondary d-none d-md-inline-flex align-items-center">
                            <i class="bi bi-code-slash me-1"></i> Swagger API
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Menu khi đã đăng nhập -->
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-light rounded-pill dropdown-toggle px-3 d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 me-2 text-danger"></i>
                                    <span>@User.Identity.Name</span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger ms-2">Admin</span>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                    <li><h6 class="dropdown-header">Tài khoản: @User.Identity.Name</h6></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Thông tin cá nhân</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-ticket-detailed me-2"></i>Vé đã đặt</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng Xuất
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Nút khi chưa đăng nhập -->
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                <i class="bi bi-person me-1"></i> Đăng Nhập
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-danger rounded-pill px-3 fw-semibold">
                                Đăng Ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer Customer -->
    <footer class="footer mt-auto py-5 bg-black border-top border-secondary text-secondary">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-danger fw-bold mb-3"><i class="bi bi-film me-2"></i>CINEMA SYSTEM</h5>
                    <p class="small text-muted">
                        Hệ thống rạp chiếu phim hiện đại chuẩn quốc tế. Mang đến trải nghiệm điện ảnh đỉnh cao với hình ảnh sắc nét và âm thanh sống động.
                    </p>
                    <div class="d-flex gap-3 fs-5 text-light">
                        <a href="#" class="text-secondary text-decoration-none"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-secondary text-decoration-none"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="text-secondary text-decoration-none"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-secondary text-decoration-none"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-light fw-bold mb-3">Quy định & Điều khoản</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="#" class="text-muted text-decoration-none">Điều khoản chung</a></li>
                        <li><a href="#" class="text-muted text-decoration-none">Chính sách bảo mật</a></li>
                        <li><a href="#" class="text-muted text-decoration-none">Chính sách hoàn vé</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-3 col-6">
                    <h6 class="text-light fw-bold mb-3">Hỗ trợ khách hàng</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-muted">
                        <li><i class="bi bi-telephone me-2"></i>Hotline: 1900 6868</li>
                        <li><i class="bi bi-envelope me-2"></i>cskh@cinemasystem.vn</li>
                        <li><i class="bi bi-clock me-2"></i>Giờ làm việc: 8:00 - 23:00</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-12">
                    <h6 class="text-light fw-bold mb-3">Tải ứng dụng di động</h6>
                    <p class="small text-muted">Trải nghiệm đặt vé tiện lợi mọi lúc mọi nơi.</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-apple me-1"></i>App Store</button>
                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-google-play me-1"></i>Google Play</button>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center small text-muted">
                <span>&copy; 2026 - Cinema Management System - PRN232 Project.</span>
                <span>Phát triển bởi Đội ngũ dự án PRN232</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
