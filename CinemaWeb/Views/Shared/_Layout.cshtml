<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Management System</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Seat Map CSS -->
    <link rel="stylesheet" href="~/css/seat-map.css" />
</head>
<body class="bg-dark text-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom border-secondary bg-black py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-danger fs-4" asp-controller="Booking" asp-action="SeatMap">
                    <i class="bi bi-film me-2"></i>CINEMA SYSTEM
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="SeatMap">
                                <i class="bi bi-grid-3x3-gap-fill me-1"></i> Sơ đồ ghế (Seat Map)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" asp-controller="Pos" asp-action="Index">
                                <i class="bi bi-display me-1"></i> Bán vé POS (Staff)
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-secondary small">
                        <span class="badge bg-secondary me-2"><i class="bi bi-hdd-network me-1"></i>Web Client</span>
                        <span>PRN232 Project</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 bg-black border-top border-secondary text-center text-secondary small">
        <div class="container">
            <span>&copy; 2026 - Cinema Management System - PRN232 (Thành viên 2: Module Đặt vé & Sơ đồ ghế)</span>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
